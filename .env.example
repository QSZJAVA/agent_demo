# ============================================================
# 部署配置：复制为 .env 后修改；也可以直接跑 ./deploy.sh
# deploy.sh 会在 .env 不存在时自动生成一份（随机密码）
# ============================================================

# 对外访问端口，80 被占用时改成 8000 之类
HTTP_PORT=80

# 浏览器访问用的地址，填服务器公网 IP 或域名；不知道就留 _
SERVER_NAME=_

# 整站访问口令（浏览器弹框输入）。页面里的"用户1 / 用户2 / 管理员"只是请求头模拟的身份，
# 没有这层口令，任何能访问端口的人都能以管理员身份改规则、派单
BASIC_AUTH_USER=demo
BASIC_AUTH_PASSWORD=change-me-web

# MySQL root 密码（改完保留好，重启不会重新初始化）
MYSQL_ROOT_PASSWORD=change-me-mysql
DB_NAME=report_demo

# 默认保留已有数据；新空库首次启动会初始化示例数据。
# 只有主动恢复演示数据时设 true（会清空报表、目录、规则和规则历史），完成后改回 false。
DEMO_RESET_ON_STARTUP=false

# 默认启用领域语法与模型协作的结构化入口；legacy 用于回滚。
SEMANTIC_MODE=active
# 原生 JSON Schema：须与模型端点能力一致。
SEMANTIC_NATIVE_SCHEMA=false
SEMANTIC_MODEL=
SEMANTIC_THINKING_ENABLED=false

# 前后端分域时填写准确前端 Origin；同源留空
CORS_ALLOWED_ORIGINS=
# 仅信任实际反向代理的 IP/CIDR（逗号分隔）；默认忽略客户端转发头
# 同机代理示例：127.0.0.1/32,::1/128；容器填写实际代理 IP/专用网段
TRUSTED_PROXY_CIDRS=

# Redis 密码
REDIS_PASSWORD=change-me-redis

# 后端启动参数：默认 mock（无需 API Key；领域语法之外使用固定语义样本）
# 接真实大模型时改成空串，并填下面三项
#   SPRING_ARGS=
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
#   LLM_API_KEY=sk-xxxx
#   LLM_MODEL=qwen3.7-plus
SPRING_ARGS=--spring.profiles.active=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# JVM 内存，小内存服务器（1G/2G）可以调小
JAVA_OPTS=-Xms256m -Xmx768m -XX:+UseG1GC -Dfile.encoding=UTF-8
