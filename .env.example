# ============================================================
# 部署配置：复制为 .env 后修改；也可以直接跑 ./deploy.sh
# deploy.sh 会在 .env 不存在时自动生成一份（随机密码）
# ============================================================

# 对外访问端口，80 被占用时改成 8000 之类
HTTP_PORT=80

# 浏览器访问用的地址，填服务器公网 IP 或域名；不知道就留 _
SERVER_NAME=_

# MySQL root 密码（改完保留好，重启不会重新初始化）
MYSQL_ROOT_PASSWORD=change-me-mysql
DB_NAME=report_demo

# Redis 密码
REDIS_PASSWORD=change-me-redis

# 后端启动参数：默认 mock 模型（无需 API Key，用关键词模拟模型跑通同一套流程）
# 接真实大模型时改成空串，并填下面三项
#   SPRING_ARGS=
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
#   LLM_API_KEY=sk-xxxx
#   LLM_MODEL=qwen3.7-plus
SPRING_ARGS=--spring.profiles.active=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# JVM 内存，小内存服务器（1G/2G）可以调小
JAVA_OPTS=-Xms256m -Xmx768m -XX:+UseG1GC -Dfile.encoding=UTF-8
