                            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                          },
                          "operator": {
                            "type": "string",
                            "description": "GTE为大于等于（以上、至少、不少于、不低于），LTE为小于等于（以下、至多、不超过、不高于），都包含等于；GT为严格大于（超过、大于），LT为严格小于（少于、小于），都排除等于。先按原文核对恰好阈值，再选算子。条件描述被排除、恢复或保留的集合，不因EXCLUDE再反转比较符。",
                            "enum": [
                              "EQ",
                              "NE",
                              "GT",
                              "GTE",
                              "LT",
                              "LTE",
                              "CONTAINS",
                              "STARTS_WITH",
                              "IN",
                              "NOT_IN",
                              "IS_NULL",
                              "NOT_NULL"
                            ]
                          },
