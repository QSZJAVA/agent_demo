{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "PREVIEW",
        "PREPARE_DISPATCH",
        "CANCEL_PLAN",
