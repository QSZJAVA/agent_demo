            "type": "string",
            "enum": [
              "INCLUDED",
              "EXCLUDED",
              "RECORD_SCOPE",
              "UNCHANGED",
              "UNCHANGED_OTHERS"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
