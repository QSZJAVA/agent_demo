  <diagram id="mcp-task-flow" name="02 完整请求流程">
    <mxGraphModel dx="1500" dy="3600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1167" pageHeight="5239" math="0" shadow="0" background="#FFFFFF" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="&lt;b&gt;01 用户发起请求&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;查询 / 生成派单清单&lt;/span&gt;" tooltip="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#6D96D0;strokeWidth=1.5;fontColor=#22334C;fontFamily=Microsoft YaHei;fontSize=12;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="550.0" y="135.0" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="auth" value="&lt;b&gt;02 会话有效？&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;登录态校验&lt;/span&gt;" tooltip="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF5D9;strokeColor=#C9A34F;strokeWidth=1.5;fontColor=#22334C;fontFamily=Microsoft YaHei;fontSize=12;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="550.0" y="235.0" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="login" value="&lt;b&gt;登录 / 重新登录&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;验证账号密码&lt;br&gt;取得可撤销会话&lt;/span&gt;" tooltip="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#6D96D0;strokeWidth=1.5;fontColor=#22334C;fontFamily=Microsoft YaHei;fontSize=12;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="636.67" y="407.0" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="entry" value="&lt;b&gt;03 Agent 接收请求&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;归属检查 · 配额 / 租约&lt;br&gt;创建或恢复对话状态&lt;/span&gt;" tooltip="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#6D96D0;strokeWidth=1.5;fontColor=#22334C;fontFamily=Microsoft YaHei;fontSize=12;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="550.0" y="569.0" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="parse" value="&lt;b&gt;04 真实模型解析&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;输出 SemanticIntent V2&lt;br&gt;格式 / 证据最多修复一次&lt;/span&gt;" tooltip="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F2ECFF;strokeColor=#A28AC9;strokeWidth=1.5;fontColor=#22334C;fontFamily=Microsoft YaHei;fontSize=12;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="550.0" y="669.0" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="validate" value="&lt;b&gt;05 意图可接受？&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;协议 / 原文证据&lt;/span&gt;" tooltip="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF5D9;strokeColor=#C9A34F;strokeWidth=1.5;fontColor=#22334C;fontFamily=Microsoft YaHei;fontSize=12;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="550.0" y="769.0" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="reject" value="&lt;b&gt;澄清 / 拒绝本轮&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;保存原因并返回用户&lt;br&gt;本轮不执行业务派单&lt;/span&gt;" tooltip="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FCEDEC;strokeColor=#CD8C86;strokeWidth=1.5;fontColor=#22334C;fontFamily=Microsoft YaHei;fontSize=12;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="646.67" y="3015.0" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="merge" value="&lt;b&gt;06 合并本轮意图&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;范围增删改 · 禁止动作&lt;br&gt;保持未修改的历史范围&lt;/span&gt;" tooltip="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#6D96D0;strokeWidth=1.5;fontColor=#22334C;fontFamily=Microsoft YaHei;fontSize=12;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="712.0" y="941.0" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="allowed" value="&lt;b&gt;07 范围与动作合法？&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;权限 + 当前状态&lt;/span&gt;" tooltip="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF5D9;strokeColor=#C9A34F;strokeWidth=1.5;fontColor=#22334C;fontFamily=Microsoft YaHei;fontSize=12;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="712.0" y="1041.0" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="action" value="&lt;b&gt;08 本轮动作？&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;查询 / 派单 / 辅助&lt;/span&gt;" tooltip="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF5D9;strokeColor=#C9A34F;strokeWidth=1.5;fontColor=#22334C;fontFamily=Microsoft YaHei;fontSize=12;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="688.67" y="1213.0" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="aux" value="&lt;b&gt;辅助动作&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;帮助 / 取消当前清单&lt;br&gt;读取已有执行结果&lt;/span&gt;" tooltip="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#6D96D0;strokeWidth=1.5;fontColor=#22334C;fontFamily=Microsoft YaHei;fontSize=12;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="1557.0" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="reuse" value="&lt;b&gt;09 可复用预览？&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;有效且范围匹配&lt;/span&gt;" tooltip="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF5D9;strokeColor=#C9A34F;strokeWidth=1.5;fontColor=#22334C;fontFamily=Microsoft YaHei;fontSize=12;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="712.0" y="1385.0" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="query" value="&lt;b&gt;10 MCP 查询&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;report_records&lt;br&gt;业务侧权限 + 有界分页&lt;/span&gt;" tooltip="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF7EE;strokeColor=#78A987;strokeWidth=1.5;fontColor=#22334C;fontFamily=Microsoft YaHei;fontSize=12;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="795.17" y="1557.0" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="snapshot" value="&lt;b&gt;11 Agent 生成预览&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;当前规则求值&lt;br&gt;保存候选、范围、版本&lt;/span&gt;" tooltip="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#6D96D0;strokeWidth=1.5;fontColor=#22334C;fontFamily=Microsoft YaHei;fontSize=12;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="771.83" y="1719.0" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="selection" value="&lt;b&gt;12 合并勾选与排除&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;校验记录属于当前预览&lt;br&gt;更新有效范围与状态&lt;/span&gt;" tooltip="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#6D96D0;strokeWidth=1.5;fontColor=#22334C;fontFamily=Microsoft YaHei;fontSize=12;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="712.0" y="1821.0" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="prepare" value="&lt;b&gt;13 需要派单清单？&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;存在候选记录&lt;/span&gt;" tooltip="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF5D9;strokeColor=#C9A34F;strokeWidth=1.5;fontColor=#22334C;fontFamily=Microsoft YaHei;fontSize=12;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="712.0" y="1921.0" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="query-done" value="&lt;b&gt;返回预览 / 规则说明&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;SSE 卡片与文字&lt;br&gt;本轮查询任务完成&lt;/span&gt;" tooltip="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#6D96D0;strokeWidth=1.5;fontColor=#22334C;fontFamily=Microsoft YaHei;fontSize=12;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="858.67" y="2093.0" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="plan" value="&lt;b&gt;14 生成待确认清单&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PENDING + 幂等键&lt;br&gt;冻结记录与版本&lt;/span&gt;" tooltip="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#6D96D0;strokeWidth=1.5;fontColor=#22334C;fontFamily=Microsoft YaHei;fontSize=12;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="688.67" y="2093.0" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="human" value="&lt;b&gt;15 用户点击确认？&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;核对确认卡片&lt;/span&gt;" tooltip="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF5D9;strokeColor=#C9A34F;strokeWidth=1.5;fontColor=#22334C;fontFamily=Microsoft YaHei;fontSize=12;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="688.67" y="2193.0" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="waiting" value="&lt;b&gt;保持待确认&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;未操作则等待用户&lt;br&gt;不自动派单&lt;/span&gt;" tooltip="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF5D9;strokeColor=#C9A34F;strokeWidth=1.5;fontColor=#22334C;fontFamily=Microsoft YaHei;fontSize=12;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="816.67" y="2387.0" width="140" height="70" as="geometry" />
        </mxCell>
