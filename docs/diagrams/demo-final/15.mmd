flowchart TD
  request["明确问题与公司报表范围<br/>可选本人查询快照<br/>历史任务读取不重新分析"]:::ui
  document["管理员维护知识草稿<br/>正文、来源、生效期、明确原因<br/>编辑不替换现行发布版本"]:::ui
  publish{"显式发布与版本核对<br/>权限、当前编辑版本与发布确认<br/>并发冲突不得自动覆盖"}:::guard
  plan["MODEL规划与独立复核<br/>完整子目标、字段、条件与数量<br/>修正次数纳入总预算"]:::model
  sources["有效业务知识与原文片段<br/>授权目录、词典、有效规则、制度<br/>先鉴权与查生效期，再均衡召回"]:::store
  search["管理员只读检索试查<br/>完整词界与已配置字段别名<br/>来源原文、命中词与覆盖范围"]:::ui
  graph{"有界只读执行图<br/>只引用前序兼容步骤<br/>禁止循环、SQL与任意工具"}:::guard
  clarify["澄清或明确失败<br/>口径缺失、能力不支持或超预算<br/>无依据不生成确定性结论"]:::error
  execute["受控计算与知识检索<br/>完整统计、精确金额、稳定排名<br/>明细展开仅使用同一来源快照"]:::agent
  mcp["认证HTTP MCP读取<br/>公司、租户与报表逐次授权<br/>不同基础查询各有观测时间"]:::business
  cancel["取消、失租或依据变化<br/>撤销令牌，拒绝迟到结果<br/>不自动重放模型或业务写入"]:::error
  steps["持久计划、步骤与实际用量<br/>请求号幂等，展示完整性边界<br/>失败与已完成步骤分别保留"]:::store
  snapshot["P1完整不可变快照<br/>翻页恢复不再请求来源或模型<br/>过期、缺行与撤权明确拒绝"]:::store
  answer["MODEL生成有依据的回答<br/>仅使用本轮实际来源<br/>简短结论逐项选择片段编号"]:::model
  citation{"程序回填原文并核对数字<br/>来源编号必须实际存在<br/>失败反馈绑定被拒绝的草稿"}:::guard
  answerReview["MODEL独立依据复核<br/>结论须被引用原文支持<br/>制度描述不能冒充已执行事实"]:::model
  result["中间结果、明细与引用依据<br/>有依据 / 依据不足 / 资料冲突<br/>刷新读取原任务，重新分析须明确发起"]:::ui
  request --> plan
  document --> publish
  publish --> sources
  sources --> search
  sources -->|"规划线索"| plan
  plan --> graph
  graph -->|"不可靠"| clarify
  graph --> execute
  sources --> execute
  execute -->|"需要业务事实"| mcp
  mcp --> snapshot
  execute --> steps
  snapshot --> steps
  cancel --> steps
  steps --> answer
  answer --> citation
  citation --> answerReview
  answerReview --> result
  classDef ui fill:#eaf2ff,stroke:#386bc1,color:#1e354c
  classDef agent fill:#edf5ff,stroke:#3778a8,color:#1e354c
  classDef model fill:#f3edff,stroke:#8751bf,color:#1e354c
  classDef business fill:#e8f7ef,stroke:#268255,color:#1e354c
  classDef guard fill:#fff4dc,stroke:#b58022,color:#1e354c
  classDef error fill:#fff0ef,stroke:#ba534e,color:#1e354c
  classDef store fill:#edf1f5,stroke:#60768b,color:#1e354c