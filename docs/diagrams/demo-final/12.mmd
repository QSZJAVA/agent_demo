flowchart TD
  entry["运营治理入口<br/>管理员菜单与六个功能页签"]:::ui
  auth{"当前管理员及数据范围校验<br/>租户、公司和报表权限共同约束"}:::guard
  metrics["授权范围内的派单统计<br/>最近1 / 7 / 30 / 90天<br/>完整分母与固定观察时间窗"]:::agent
  manage["工作台 / 策略 / 留存<br/>核对、重试、关闭须提供原因<br/>策略保存与回滚带期望版本"]:::ui
  detail["派单状态明细<br/>最多1000分组，截断明确提示<br/>成功率仍按授权范围全量计算"]:::ui
  action["按动作提交并复核<br/>核对重试进入持久任务<br/>其他管理操作由专用接口处理"]:::agent
  meaning{"指标可用性分别说明<br/>无授权与无记录分别呈现<br/>解析与耗时范围不可核实"}:::guard
  audit["访问审计与恢复依据<br/>记录真实操作者、动作和结果<br/>清理展示副本、保留汇总及防重<br/>在途、失败与待核对证据保留"]:::store
  boundary{"证据范围分别说明<br/>名称解析评估不是模型准确率<br/>指标不是生产容量或SLA验收"}:::guard
  entry --> auth
  auth -->|"指标"| metrics
  auth -->|"治理操作"| manage
  metrics --> detail
  detail --> meaning
  manage --> action
  action --> audit
  meaning --> boundary
  audit --> boundary
  classDef ui fill:#eaf2ff,stroke:#386bc1,color:#1e354c
  classDef agent fill:#edf5ff,stroke:#3778a8,color:#1e354c
  classDef model fill:#f3edff,stroke:#8751bf,color:#1e354c
  classDef business fill:#e8f7ef,stroke:#268255,color:#1e354c
  classDef guard fill:#fff4dc,stroke:#b58022,color:#1e354c
  classDef error fill:#fff0ef,stroke:#ba534e,color:#1e354c
  classDef store fill:#edf1f5,stroke:#60768b,color:#1e354c