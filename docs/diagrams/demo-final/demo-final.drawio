<mxfile host="app.diagrams.net" modified="2026-10-09T00:00:00.000Z" agent="Codex" version="26.0.0"><diagram id="semantic-1" name="01 系统与信任边界"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ui" value="&lt;b&gt;浏览器登录与报表工作台&lt;/b&gt;&lt;br&gt;用户会话与业务权限" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;Agent REST / SSE :8080&lt;/b&gt;&lt;br&gt;查询、会话、派单与运营管理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="model" value="&lt;b&gt;真实模型 · MODEL&lt;/b&gt;&lt;br&gt;受控规划、工具提议与结论结构" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3edff;strokeColor=#8751bf;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="semantic" value="&lt;b&gt;统一任务规划与独立复核&lt;/b&gt;&lt;br&gt;查询字段白名单 / 派单证据与集合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="investigate" value="&lt;b&gt;独立异常调查入口&lt;/b&gt;&lt;br&gt;有界上下文与六个只读工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="state" value="&lt;b&gt;MySQL + Redis&lt;/b&gt;&lt;br&gt;单一 V1 空库基线 · 38 表 / 456 字段&lt;br&gt;状态、字段快照、租约、版本" style="rounded=1;whiteSpace