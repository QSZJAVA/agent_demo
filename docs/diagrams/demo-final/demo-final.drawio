try relative="1" as="geometry"/></mxCell><mxCell id="e15" value="复核结构或依据无效" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="compare" target="reviewfix"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="重试同一草稿" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="reviewfix" target="review"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="复核预算耗尽" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="reviewfix" target="fail"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="修正完整任务" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="retry" target="model"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="semantic-3" name="03 配置字段与实体选择"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="change" value="&lt;b&gt;RECORDS 操作&lt;/b&gt;&lt;br&gt;EXCLUDE / RESTORE / KEEP_ONLY等" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="scope" value="&lt;b&gt;按 reportMentions 限定记录&lt;/b&gt;&lt;br&gt;校验报表权限及当前预览" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="fields" value="&lt;b&gt;FIELDS 条件编译&lt;/b&gt;&lt;br&gt;目录字段白名单、类型、允许操作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="entity" value="&lt;b&gt;单据 / 摘要 / 客户 / 整类&lt;/b&gt;&lt;br&gt;DOCUMENT / DESCRIPTION&lt;br&gt;COUNTERPARTY / ALL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="eval" value="&lt;b&gt;有界AND / OR条件求值&lt;/b&gt;&lt;br&gt;各报表按已声明字段匹配&lt;br&gt;未声明字段不当作业务空值" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="unique" value="&lt;b&gt;实体、数量与整类操作校验&lt;/b&gt;&lt;br&gt;多客户歧义不能用全部绕过" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="complete" value="&lt;b&gt;完整快照及整轮原子性&lt;/b&gt;&lt;br&gt;任一项失败不提交部分排除" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="commit" value="&lt;b&gt;更新复合记录键集合&lt;/b&gt;&lt;br&gt;仅更新当前授权报表子集&lt;br&gt;只保留须有明确排他依据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="refuse" value="&lt;b&gt;未知字段 / 歧义 / 缺失事实&lt;/b&gt;&lt;br&gt;明确提示并保留恢复路径" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#ba534e;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="reference" value="&lt;b&gt;REFERENCE 当前预览引用&lt;/b&gt;&lt;br&gt;绑定预览及复合记录标识&lt;br&gt;核对本轮点名冲突与数量" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="change" target="scope"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="字段条件" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="scope" target="fields"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="实体选择" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="scope" target="entity"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="fields" target="eval"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="entity" target="unique"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="eval" target="complete"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="unique" target="complete"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="全部成功" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="complete" target="commit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="complete" target="refuse"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="已有引用" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="scope" target="reference"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="reference" target="complete"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="semantic-4" name="04 预览、字段快照与恢复"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="desired" value="&lt;b&gt;desired 与 effective 分开&lt;/b&gt;&lt;br&gt;通过预检的范围 / 最近成功范围" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="reuse" value="&lt;b&gt;范围相同且预览有效？&lt;/b&gt;&lt;br&gt;纯记录操作复用原预览" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="query" value="&lt;b&gt;按权限与规则查询&lt;/b&gt;&lt;br&gt;范围扫描或绑定精确目标读取&lt;br&gt;异常整次失败，保留旧预览/清单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="snapshot" value="&lt;b&gt;冻结预览&lt;/b&gt;&lt;br&gt;客户实体 + FieldFact 字段快照&lt;br&gt;精确目标和原查询引用随快照冻结" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="selection" value="&lt;b&gt;选择绑定预览ID与记录键&lt;/b&gt;&lt;br&gt;预览权限校验 + 手动选择CAS保存&lt;br&gt;只保留须排他限定；不动须UNCHANGED" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="pending" value="&lt;b&gt;未完成请求独立标记&lt;/b&gt;&lt;br&gt;不污染已确定公司与报表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#ba534e;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="resume" value="&lt;b&gt;明确新操作可继续&lt;/b&gt;&lt;br&gt;含糊的直接建单仍被阻止" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="reload" value="&lt;b&gt;刷新 / 重启 / 会话恢复&lt;/b&gt;&lt;br&gt;重读权威状态，不重新猜选择" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="desired" target="reuse"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="需新查询" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="reuse" target="query"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="query" target="snapshot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="可复用" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="reuse" target="selection"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="snapshot" target="selection"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="成功" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="selection" target="reload"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="selection" target="pending"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="pending" target="resume"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="明确纠正" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="resume" target="selection"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="semantic-5" name="05 确认与持久执行任务"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="plan" value="&lt;b&gt;生成待确认清单&lt;/b&gt;&lt;br&gt;复制字段与客户快照、固定排除项" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="confirm" value="&lt;b&gt;用户核对并点击确认&lt;/b&gt;&lt;br&gt;持久任务 + 稳定幂等键" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="gate" value="&lt;b&gt;归属、权限、TTL、版本&lt;/b&gt;&lt;br&gt;按租户认领并冻结执行版本" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="intent" value="&lt;b&gt;逐条持久化发送意图&lt;/b&gt;&lt;br&gt;稳定requestId、UNKNOWN及审计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="mcp" value="&lt;b&gt;dispatch_submit&lt;/b&gt;&lt;br&gt;服务认证与用户当前权限" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="lock" value="&lt;b&gt;业务事务与锁定复核&lt;/b&gt;&lt;br&gt;行锁内复核全部确认字段及版本&lt;br&gt;字段变化要求重新查询确认" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="write" value="&lt;b&gt;原子提交状态与请求结果&lt;/b&gt;&lt;br&gt;相同请求号及负载可重放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1125" width="340" height="110" as="geometry"/></mxCell><mxCell id="result" value="&lt;b&gt;持久结果回到页面&lt;/b&gt;&lt;br&gt;刷新与断线不导致重新派单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1290" width="340" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="plan" target="confirm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="confirm" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="gate" target="intent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="intent" target="mcp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="mcp" target="lock"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="lock" target="write"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="write" target="result"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="semantic-6" name="06 未知结果、核对与重试"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="result" value="&lt;b&gt;读取条目持久结果&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="success" value="&lt;b&gt;SUCCESS&lt;/b&gt;&lt;br&gt;重放原结果，不重复写入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="unknown" value="&lt;b&gt;UNKNOWN / REVIEW_REQUIRED&lt;/b&gt;&lt;br&gt;先按原请求号核对" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="failed" value="&lt;b&gt;明确FAILED&lt;/b&gt;&lt;br&gt;用户显式请求重试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="lookup" value="&lt;b&gt;dispatch_lookup&lt;/b&gt;&lt;br&gt;当前权限与原操作者检查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="retry" value="&lt;b&gt;用户明确重试后重新复核&lt;/b&gt;&lt;br&gt;沿用请求号与已确认快照&lt;br&gt;重新认领并冻结本次执行版本" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="remain" value="&lt;b&gt;仍不确定或权限不足&lt;/b&gt;&lt;br&gt;保留证据，不能自动重发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#ba534e;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="execute" value="&lt;b&gt;受控执行 / 结果归档&lt;/b&gt;&lt;br&gt;幂等与版本保护继续生效" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="result" target="success"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="result" target="unknown"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="result" target="failed"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="unknown" target="lookup"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="已成功" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="lookup" target="success"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="仍不确定" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="lookup" target="remain"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="明确失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="lookup" target="failed"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="failed" target="retry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="retry" target="execute"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="semantic-7" name="07 异常调查与证据"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ui" value="&lt;b&gt;用户显式发起异常调查&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="run" value="&lt;b&gt;登记调查运行与租约&lt;/b&gt;&lt;br&gt;任务预算、取消及恢复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="context" value="&lt;b&gt;有界上下文与证据索引&lt;/b&gt;&lt;br&gt;已取得证据与context-v2笔记&lt;br&gt;超阈值整理；按E编号回读" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="model" value="&lt;b&gt;真实模型提出只读工具请求&lt;/b&gt;&lt;br&gt;收集最多6次；工具最多16次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3edff;strokeColor=#8751bf;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="tools" value="&lt;b&gt;参数与权限校验后调用&lt;/b&gt;&lt;br&gt;六个只读工具，按需核对MCP&lt;br&gt;逐次权限/来源/执行权检查" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="facts" value="&lt;b&gt;保存步骤、事实与引用&lt;/b&gt;&lt;br&gt;缺失事实不能编造为结论" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="report" value="&lt;b&gt;无工具报告及最多一次修正&lt;/b&gt;&lt;br&gt;模型给结构化结论与证据引用&lt;br&gt;程序核验事实并生成说明文本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1125" width="340" height="110" as="geometry"/></mxCell><mxCell id="display" value="&lt;b&gt;报告与中文步骤展示&lt;/b&gt;&lt;br&gt;部分完成、来源变化明确提示&lt;br&gt;取消或失租不回写，不自动重放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1290" width="340" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="ui" target="run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="run" target="context"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="context" target="model"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="model" target="tools"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="tools" target="facts"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="下一步" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="facts" target="context"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="结束或预算边界" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="facts" target="report"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="report" target="display"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="semantic-8" name="08 最终演示与验收路径"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="manifest" value="&lt;b&gt;demo-baseline.json&lt;/b&gt;&lt;br&gt;V1 / real,mcp / active&lt;br&gt;原生 JSON Schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="start" value="&lt;b&gt;start-app 或 start-mcp&lt;/b&gt;&lt;br&gt;业务服务就绪后再启动Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="prepare" value="&lt;b&gt;prepare-demo 一次准备&lt;/b&gt;&lt;br&gt;report_demo；数据操作须授权&lt;br&gt;不清库，不复位已派单记录" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="preview" value="&lt;b&gt;未派单基线下A公司九条&lt;/b&gt;&lt;br&gt;销售3、应收4、费用2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="amount" value="&lt;b&gt;销售金额大于96000不要&lt;/b&gt;&lt;br&gt;仅排除128000，保留等号边界" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="document" value="&lt;b&gt;再排除SO2026002&lt;/b&gt;&lt;br&gt;保持三类报表，剩余七条" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="verify" value="&lt;b&gt;分层回归与恢复检查&lt;/b&gt;&lt;br&gt;14步字段回放仅适用指定基线&lt;br&gt;模型/HTTP/数据库/前端分别取证" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1125" width="340" height="110" as="geometry"/></mxCell><mxCell id="limits" value="&lt;b&gt;证据边界如实保留&lt;/b&gt;&lt;br&gt;外部ERP、正式认证与生产验收待完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#ba534e;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1290" width="340" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="manifest" target="start"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="start" target="prepare"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="prepare" target="preview"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="preview" target="amount"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="amount" target="document"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="document" target="verify"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="verify" target="limits"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="semantic-9" name="09 通用查询与连续上下文"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="input" value="&lt;b&gt;自然语言或分页请求&lt;/b&gt;&lt;br&gt;报表数据 / 单条资格 / 派单 / 工单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="lease" value="&lt;b&gt;会话租约与当前权限&lt;/b&gt;&lt;br&gt;请求归属、配额、历史权限版本" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="model" value="&lt;b&gt;统一任务草稿 → MODEL&lt;/b&gt;&lt;br&gt;成功查询、展示行、完整性和焦点&lt;br&gt;撤销条件须有本轮原文证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3edff;strokeColor=#8751bf;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="dispatch" value="&lt;b&gt;派单目标与选择预检&lt;/b&gt;&lt;br&gt;查询 row-N 与候选 ref_* 分离&lt;br&gt;可靠明细可绑定精确目标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="source" value="&lt;b&gt;可派单来源与业务焦点&lt;/b&gt;&lt;br&gt;汇总须先列出记录或候选&lt;br&gt;被查询打断的旧候选须重新展示" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="sourcefail" value="&lt;b&gt;澄清并保留原有状态&lt;/b&gt;&lt;br&gt;待补齐明细或重新展示候选&lt;br&gt;不从未经核对的来源准备清单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#ba534e;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="query" value="&lt;b&gt;AssistantCodec / BusinessQuery&lt;/b&gt;&lt;br&gt;严格类型、来源及稳定身份校验" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="clarify" value="&lt;b&gt;澄清 / 拒绝 / 失败&lt;/b&gt;&lt;br&gt;不丢弃不支持条件、不执行写入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#ba534e;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="mcp" value="&lt;b&gt;HTTP MCP business_query&lt;/b&gt;&lt;br&gt;真实只读草稿预检及当前授权" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="facts" value="&lt;b&gt;完整受限读取与确定性统计&lt;/b&gt;&lt;br&gt;10万行 / 120秒 / 16MiB&lt;br&gt;成功事实本轮复用；不重复读取" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="card" value="&lt;b&gt;复核当前权限后持久化&lt;/b&gt;&lt;br&gt;总数、展示引用、时点和权限并集" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1290" width="340" height="110" as="geometry"/></mxCell><mxCell id="ui" value="&lt;b&gt;列表、详情、总结与翻页&lt;/b&gt;&lt;br&gt;刷新可恢复；权限变化阻止旧事实展示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1455" width="340" height="110" as="geometry"/></mxCell><mxCell id="repair" value="&lt;b&gt;有界草稿修正&lt;/b&gt;&lt;br&gt;契约和语义错误最多修正两次&lt;br&gt;预算耗尽后澄清，其他故障直接返回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3edff;strokeColor=#8751bf;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="review" value="&lt;b&gt;独立语义复核 → MODEL&lt;/b&gt;&lt;br&gt;有来源的要求与完整任务期望&lt;br&gt;程序比较行为，详见流程02" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3edff;strokeColor=#8751bf;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1125" width="340" height="110" as="geometry"/></mxCell><mxCell id="prepare" value="&lt;b&gt;精确预览与待确认清单&lt;/b&gt;&lt;br&gt;重核当前权限、来源、规则与条数&lt;br&gt;新预览恢复焦点；等待用户确认" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="1290" width="340" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="input" target="lease"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="lease" target="model"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="只读" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="model" target="query"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="派单" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="model" target="dispatch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="最终失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="model" target="clarify"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="query" target="mcp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="mcp" target="facts"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="card" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="query" target="repair"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="契约错误" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="facts" target="repair"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="预算内" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="repair" target="model"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="repair" target="clarify"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="facts" target="review"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="dispatch" target="source"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="来源合格" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="source" target="review"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="须列明细或重新展示" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="source" target="sourcefail"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="查询通过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="review" target="card"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="派单通过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="review" target="prepare"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="语义偏差" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="review" target="repair"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="业务故障" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="mcp" target="clarify"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="semantic-10" name="10 工单进度与总结"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="query" value="&lt;b&gt;工单列表 / 详情 / 总结&lt;/b&gt;&lt;br&gt;编号、状态、公司、报表或处理人" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="access" value="&lt;b&gt;当前授权范围与查询预算&lt;/b&gt;&lt;br&gt;不可见工单与不存在工单统一拒绝" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="provider" value="&lt;b&gt;WorkOrderProvider 只读接口&lt;/b&gt;&lt;br&gt;返回完整有界事实，不推进审批" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="fixture" value="&lt;b&gt;固定演示示例&lt;/b&gt;&lt;br&gt;待审批、处理中、完成、驳回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="linked" value="&lt;b&gt;实际演示派单关联&lt;/b&gt;&lt;br&gt;成功条目映射固定首个审批环节" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="steps" value="&lt;b&gt;固定环节与固定处理人&lt;/b&gt;&lt;br&gt;提交 → 部门审批 → 财务复核&lt;br&gt;业务处理 → 归档；未来步骤未到达" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="summary" value="&lt;b&gt;确定性汇总同一范围&lt;/b&gt;&lt;br&gt;当前审批人、状态分布、分币种金额" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="card" value="&lt;b&gt;来源、时间线及办理小结&lt;/b&gt;&lt;br&gt;终态无当前待办；不提供审批按钮" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1125" width="340" height="110" as="geometry"/></mxCell><mxCell id="external" value="&lt;b&gt;真实工单系统接入待完成&lt;/b&gt;&lt;br&gt;替换业务提供者后须重新验收" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#ba534e;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="1125" width="340" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="query" target="access"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="access" target="provider"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="provider" target="fixture"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="provider" target="linked"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="fixture" target="steps"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="linked" target="steps"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="steps" target="summary"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="summary" target="card"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="后续接入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="provider" target="external"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="semantic-11" name="11 手工派单与记录详情"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="page" value="&lt;b&gt;报表页业务明细&lt;/b&gt;&lt;br&gt;授权范围分页；金额为本页合计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="select" value="&lt;b&gt;勾选当前页未派单记录&lt;/b&gt;&lt;br&gt;每次1～50条，核对后确认" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="history" value="&lt;b&gt;右上角“派单记录”&lt;/b&gt;&lt;br&gt;独立抽屉，每页最多50条&lt;br&gt;仅当前用户、当前报表手工记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="job" value="&lt;b&gt;DIRECT持久任务&lt;/b&gt;&lt;br&gt;稳定幂等键、权限与版本校验&lt;br&gt;每条记录生成可追溯清单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="read" value="&lt;b&gt;读取服务器记录&lt;/b&gt;&lt;br&gt;加载错误可刷新，未知先核对" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="execute" value="&lt;b&gt;认证HTTP MCP执行&lt;/b&gt;&lt;br&gt;来源行锁、字段快照和原请求号&lt;br&gt;持久结果回到报表与记录抽屉" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="details" value="&lt;b&gt;展开详情 / 收起详情&lt;/b&gt;&lt;br&gt;文字按钮或箭头所在整格&lt;br&gt;按planId保留同页刷新展开状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="trace" value="&lt;b&gt;完整追溯 / 按状态处理&lt;/b&gt;&lt;br&gt;事件、审计、会话、逐条结果&lt;br&gt;待核对先查；明确失败才重试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="safe" value="&lt;b&gt;详情切换仅改变本地显示&lt;/b&gt;&lt;br&gt;关闭抽屉不取消后台任务&lt;br&gt;业务动作继续走原保护链路" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="e0" value="发起派单" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="page" target="select"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="查看记录" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="page" target="history"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="select" target="job"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="job" target="execute"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="history" target="read"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="read" target="details"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="结果刷新" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="execute" target="read"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="按需查看或处理" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="details" target="trace"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="details" target="safe"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="trace" target="safe"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="semantic-12" name="12 运营治理与展示口径"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="entry" value="&lt;b&gt;运营治理入口&lt;/b&gt;&lt;br&gt;管理员菜单与六个功能页签" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="auth" value="&lt;b&gt;当前管理员及租户校验&lt;/b&gt;&lt;br&gt;任务处理另核对清单业务范围" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="metrics" value="&lt;b&gt;业务指标完整汇总&lt;/b&gt;&lt;br&gt;最近1 / 7 / 30 / 90天&lt;br&gt;解析请求与当前派单条目分母" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="manage" value="&lt;b&gt;工作台 / 策略 / 留存&lt;/b&gt;&lt;br&gt;核对、重试、关闭须提供原因&lt;br&gt;策略保存与回滚带期望版本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="detail" value="&lt;b&gt;中文环节、报表和状态&lt;/b&gt;&lt;br&gt;明细最多1000组，每页20组&lt;br&gt;中文搜索不改变顶部比例" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="action" value="&lt;b&gt;按动作提交并复核&lt;/b&gt;&lt;br&gt;核对重试进入持久任务&lt;br&gt;其他管理操作由专用接口处理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="meaning" value="&lt;b&gt;已执行不等于全部成功&lt;/b&gt;&lt;br&gt;无样本显示暂无数据&lt;br&gt;95%耗时单位为毫秒" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="audit" value="&lt;b&gt;访问审计与恢复依据&lt;/b&gt;&lt;br&gt;记录操作者、动作和结果&lt;br&gt;原始资源标识保留可查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="boundary" value="&lt;b&gt;证据范围分别说明&lt;/b&gt;&lt;br&gt;名称解析评估不是模型准确率&lt;br&gt;指标不是生产容量或SLA验收" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="entry" target="auth"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="指标" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="auth" target="metrics"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="治理操作" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="auth" target="manage"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="metrics" target="detail"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="detail" target="meaning"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="manage" target="action"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="action" target="audit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="meaning" target="boundary"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="audit" target="boundary"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>