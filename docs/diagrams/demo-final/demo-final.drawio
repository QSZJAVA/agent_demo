<mxfile host="app.diagrams.net" modified="2026-10-06T00:00:00.000Z" agent="Codex" version="26.0.0"><diagram id="semantic-1" name="01 系统与信任边界"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ui" value="&lt;b&gt;浏览器登录与报表工作台&lt;/b&gt;&lt;br&gt;用户会话与业务权限" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;Agent REST / SSE :8080&lt;/b&gt;&lt;br&gt;会话、目录、规则、预览与清单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="model" value="&lt;b&gt;真实模型 · MODEL&lt;/b&gt;&lt;br&gt;仅输出意图或调查工具提议" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3edff;strokeColor=#8751bf;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="semantic" value="&lt;b&gt;V1 语义与确定性规划&lt;/b&gt;&lt;br&gt;字段类型、原文证据、集合运算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="investigate" value="&lt;b&gt;独立异常调查入口&lt;/b&gt;&lt;br&gt;有界上下文与六个只读工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="state" value="&lt;b&gt;MySQL + Redis&lt;/b&gt;&lt;br&gt;单一 V1 空库基线 · 38 表 / 456 字段&lt;br&gt;状态、字段快照、租约、版本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="mcp" value="&lt;b&gt;HTTP MCP :8090&lt;/b&gt;&lt;br&gt;独立服务凭据及用户授权" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="source" value="&lt;b&gt;受控来源事实与业务事务&lt;/b&gt;&lt;br&gt;本仓库示例表；外部ERP待接入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="ui" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="api" target="semantic"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="api" target="investigate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="semantic" target="model"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="investigate" target="model"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="semantic" target="state"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="investigate" target="state"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="semantic" target="mcp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="只读" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="investigate" target="mcp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="mcp" target="source"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="确认与版本复核" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="mcp" target="state"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="semantic-2" name="02 模型解析与校验"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="in" value="&lt;b&gt;本轮用户原话&lt;/b&gt;&lt;br&gt;查询、记录选择或生成清单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="context" value="&lt;b&gt;构造有界受控上下文&lt;/b&gt;&lt;br&gt;当前状态、授权报表及字段元数据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="model" value="&lt;b&gt;ModelIntentParser → MODEL&lt;/b&gt;&lt;br&gt;V1 Schema、稳定规则与抽象对照&lt;br&gt;明确凭据阻断、上下文统一脱敏" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3edff;strokeColor=#8751bf;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="codec" value="&lt;b&gt;IntentCodec 校验&lt;/b&gt;&lt;br&gt;结构、类型、原文证据、禁止条件" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="retry" value="&lt;b&gt;最多一次修正&lt;/b&gt;&lt;br&gt;将具体校验错误交回模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3edff;strokeColor=#8751bf;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="draft" value="&lt;b&gt;SemanticPlanner 草稿校验&lt;/b&gt;&lt;br&gt;覆盖、实体角色与范围一致性" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="fail" value="&lt;b&gt;澄清 / 拒绝 / 失败&lt;/b&gt;&lt;br&gt;不提交部分选择、不自动建单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#ba534e;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="apply" value="&lt;b&gt;确定性业务流程&lt;/b&gt;&lt;br&gt;范围 → 快照 → 选择 → 待确认清单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="in" target="context"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="context" target="model"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="model" target="codec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="首次失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="codec" target="retry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="retry" target="model"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="合格" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="codec" target="draft"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="首次矛盾" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="draft" target="retry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="再次失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="codec" target="fail"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="业务拒绝" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="draft" target="fail"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="合格" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="draft" target="apply"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="semantic-3" name="03 配置字段与实体选择"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="change" value="&lt;b&gt;RECORDS 操作&lt;/b&gt;&lt;br&gt;EXCLUDE / RESTORE / KEEP_ONLY等" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="scope" value="&lt;b&gt;按 reportMentions 限定记录&lt;/b&gt;&lt;br&gt;校验报表权限及当前预览" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="fields" value="&lt;b&gt;FIELDS 条件编译&lt;/b&gt;&lt;br&gt;目录字段白名单、类型、允许操作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="entity" value="&lt;b&gt;DOCUMENT / DESCRIPTION&lt;/b&gt;&lt;br&gt;或 COUNTERPARTY 稳定客户关联" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="eval" value="&lt;b&gt;有界AND / OR条件求值&lt;/b&gt;&lt;br&gt;精确十进制、ISO日期、文本和布尔" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="unique" value="&lt;b&gt;唯一实体与数量校验&lt;/b&gt;&lt;br&gt;ALL不能跨同名客户合并" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="complete" value="&lt;b&gt;完整快照及整轮原子性&lt;/b&gt;&lt;br&gt;任一项失败不提交部分排除" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="commit" value="&lt;b&gt;更新复合记录键集合&lt;/b&gt;&lt;br&gt;限定报表之外的选择保持" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="refuse" value="&lt;b&gt;未知字段 / 歧义 / 缺失事实&lt;/b&gt;&lt;br&gt;明确提示并保留恢复路径" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#ba534e;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="change" target="scope"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="字段条件" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="scope" target="fields"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="实体选择" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="scope" target="entity"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="fields" target="eval"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="entity" target="unique"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="eval" target="complete"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="unique" target="complete"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="全部成功" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="complete" target="commit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="complete" target="refuse"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="semantic-4" name="04 预览、字段快照与恢复"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="desired" value="&lt;b&gt;desired 与 effective 分开&lt;/b&gt;&lt;br&gt;最近请求范围 / 最近成功范围" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="reuse" value="&lt;b&gt;范围相同且预览有效？&lt;/b&gt;&lt;br&gt;纯记录操作复用原预览" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="query" value="&lt;b&gt;按权限与规则查询&lt;/b&gt;&lt;br&gt;每页500条；总量10万、120秒&lt;br&gt;异常整次失败，保留旧预览/清单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="snapshot" value="&lt;b&gt;冻结预览&lt;/b&gt;&lt;br&gt;客户实体 + FieldFact字段快照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="selection" value="&lt;b&gt;选择绑定预览ID与记录键&lt;/b&gt;&lt;br&gt;预览权限校验 + 手动选择CAS保存&lt;br&gt;只保留须排他限定；不动须UNCHANGED" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="pending" value="&lt;b&gt;未完成请求独立标记&lt;/b&gt;&lt;br&gt;不污染已确定公司与报表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#ba534e;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="resume" value="&lt;b&gt;明确新操作可继续&lt;/b&gt;&lt;br&gt;含糊的直接建单仍被阻止" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="reload" value="&lt;b&gt;刷新 / 重启 / 会话恢复&lt;/b&gt;&lt;br&gt;重读权威状态，不重新猜选择" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="desired" target="reuse"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="需新查询" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="reuse" target="query"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="query" target="snapshot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="可复用" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="reuse" target="selection"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="snapshot" target="selection"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="成功" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="selection" target="reload"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="selection" target="pending"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="pending" target="resume"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="明确纠正" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="resume" target="selection"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="semantic-5" name="05 确认与持久执行任务"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="plan" value="&lt;b&gt;生成待确认清单&lt;/b&gt;&lt;br&gt;复制字段与客户快照、固定排除项" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="confirm" value="&lt;b&gt;用户核对并点击确认&lt;/b&gt;&lt;br&gt;持久任务 + 稳定幂等键" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="gate" value="&lt;b&gt;归属、权限、TTL、版本&lt;/b&gt;&lt;br&gt;按租户认领并冻结执行版本" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="intent" value="&lt;b&gt;逐条持久化发送意图&lt;/b&gt;&lt;br&gt;稳定requestId、UNKNOWN及审计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="mcp" value="&lt;b&gt;dispatch_submit&lt;/b&gt;&lt;br&gt;服务认证与用户当前权限" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="lock" value="&lt;b&gt;业务事务与锁定复核&lt;/b&gt;&lt;br&gt;行锁内复核全部确认字段及版本&lt;br&gt;字段变化要求重新查询确认" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="write" value="&lt;b&gt;原子提交状态与请求结果&lt;/b&gt;&lt;br&gt;相同请求号及负载可重放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1125" width="340" height="110" as="geometry"/></mxCell><mxCell id="result" value="&lt;b&gt;持久结果回到页面&lt;/b&gt;&lt;br&gt;刷新与断线不导致重新派单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1290" width="340" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="plan" target="confirm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="confirm" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="gate" target="intent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="intent" target="mcp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="mcp" target="lock"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="lock" target="write"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="write" target="result"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="semantic-6" name="06 未知结果、核对与重试"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="result" value="&lt;b&gt;读取条目持久结果&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="success" value="&lt;b&gt;SUCCESS&lt;/b&gt;&lt;br&gt;重放原结果，不重复写入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="unknown" value="&lt;b&gt;UNKNOWN / REVIEW_REQUIRED&lt;/b&gt;&lt;br&gt;先按原请求号核对" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="failed" value="&lt;b&gt;明确FAILED&lt;/b&gt;&lt;br&gt;用户显式请求重试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="lookup" value="&lt;b&gt;dispatch_lookup&lt;/b&gt;&lt;br&gt;当前权限与原操作者检查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="retry" value="&lt;b&gt;复核当前规则和执行权&lt;/b&gt;&lt;br&gt;沿用稳定请求号与冻结版本" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="remain" value="&lt;b&gt;仍不确定或权限不足&lt;/b&gt;&lt;br&gt;保留证据，不能自动重发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#ba534e;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="execute" value="&lt;b&gt;受控执行 / 结果归档&lt;/b&gt;&lt;br&gt;幂等与版本保护继续生效" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="result" target="success"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="result" target="unknown"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="result" target="failed"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="unknown" target="lookup"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="已成功" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="lookup" target="success"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="仍不确定" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="lookup" target="remain"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="可确认重试" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="lookup" target="retry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="failed" target="retry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="retry" target="execute"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="semantic-7" name="07 异常调查与证据"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ui" value="&lt;b&gt;用户显式发起异常调查&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=1