xCell id="in" value="&lt;b&gt;本轮完整任务&lt;/b&gt;&lt;br&gt;查询、资格核验或待确认派单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="context" value="&lt;b&gt;构造有界受控上下文&lt;/b&gt;&lt;br&gt;授权目录、真实对话与可靠对象&lt;br&gt;两阶段使用同一完整任务契约" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="model" value="&lt;b&gt;统一任务规划 → MODEL&lt;/b&gt;&lt;br&gt;AssistantPlan + DispatchDirective&lt;br&gt;原生 Schema、thinking 关闭" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3edff;strokeColor=#8751bf;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="codec" value="&lt;b&gt;严格结构与引用校验&lt;/b&gt;&lt;br&gt;类型、身份、原文与来源绑定" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="retry" value="&lt;b&gt;最多两次草稿修正&lt;/b&gt;&lt;br&gt;保留累计草稿、事实及全部差异&lt;br&gt;合法独立期望保持不变" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3edff;strokeColor=#8751bf;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="draft" value="&lt;b&gt;只读业务预检&lt;/b&gt;&lt;br&gt;MCP 查询事实 / 派单目标与选择" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="terms" value="&lt;b&gt;原文命中的字段词义&lt;/b&gt;&lt;br&gt;授权字符串字段值，最多64项&lt;br&gt;不提供行身份、草稿或结果全集" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="review" value="&lt;b&gt;独立语义复核 → MODEL&lt;/b&gt;&lt;br&gt;原文、受控上下文与词义线索&lt;br&gt;合法完整期望在本轮固定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3edff;strokeColor=#8751bf;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="compare" value="&lt;b&gt;程序比较完整任务与数量&lt;/b&gt;&lt;br&gt;动作、条件及本轮原文依据&lt;br&gt;最终条数另核对完整预检事实" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1125" width="340" height="110" as="geometry"/></mxCell><mxCell id="reviewfix" value="&lt;b&gt;修复复核自身&lt;/b&gt;&lt;br&gt;仅修复无效依据或结构，不改草稿&lt;br&gt;共享整轮三次复核预算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3edff;strokeColor=#8751bf;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="1125" width="340" height="110" as="geometry"/></mxCell><mxCell id="fail" value="&lt;b&gt;澄清 / 拒绝 / 失败&lt;/b&gt;&lt;br&gt;保留原候选和清单&lt;br&gt;失败原因留存供后续恢复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#ba534e;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="apply" value="&lt;b&gt;按已复核任务执行&lt;/b&gt;&lt;br&gt;只应用已校验的操作字段&lt;br&gt;澄清可采用已复核表达" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1290" width="340" height="110" as="geometry"/></mx