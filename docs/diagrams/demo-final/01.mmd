flowchart TD
  ui["浏览器登录与报表工作台<br/>用户会话与业务权限"]:::ui
  api["Agent REST / SSE :8080<br/>会话、目录、规则、预览与清单"]:::agent
  model["真实模型 · MODEL<br/>仅输出意图或调查工具提议"]:::model
  semantic["V1 语义与确定性规划<br/>字段类型、原文证据、集合运算"]:::agent
  investigate["独立异常调查入口<br/>有界上下文与六个只读工具"]:::agent
  state["MySQL + Redis<br/>单一 V1 空库基线 · 38 表 / 456 字段<br/>状态、字段快照、租约、版本"]:::store
  mcp["HTTP MCP :8090<br/>独立服务凭据及用户授权"]:::business
  source["受控来源事实与业务事务<br/>本仓库示例表；外部ERP待接入"]:::store
  ui --> api
  api --> semantic
  api --> investigate
  semantic --> model
  investigate --> model
  semantic --> state
  investigate --> state
  semantic --> mcp
  investigate -->|"只读"| mcp
  mcp --> source
  mcp -->|"确认与版本复核"| state
  classDef ui fill:#eaf2ff,stroke:#386bc1,color:#1e354c
  classDef agent fill:#edf5ff,stroke:#3778a8,color:#1e354c
  classDef model fill:#f3edff,stroke:#8751bf,color:#1e354c
  classDef business fill:#e8f7ef,stroke:#268255,color:#1e354c
  classDef guard fill:#fff4dc,stroke:#b58022,color:#1e354c
  classDef error fill:#fff0ef,stroke:#ba534e,color:#1e354c
  classDef store fill:#edf1f5,stroke:#60768b,color:#1e354c