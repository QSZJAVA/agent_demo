flowchart TD
  query["工单列表 / 详情 / 总结<br/>编号、状态、公司、报表或处理人"]:::agent
  access{"当前授权范围与查询预算<br/>不可见工单与不存在工单统一拒绝"}:::guard
  provider["WorkOrderProvider 只读接口<br/>返回完整有界事实，不推进审批"]:::business
  fixture["固定演示示例<br/>待审批、处理中、完成、驳回"]:::business
  linked["实际演示派单关联<br/>成功条目映射固定首个审批环节"]:::business
  steps["固定环节与固定处理人<br/>提交 → 部门审批 → 财务复核<br/>业务处理 → 归档；未来步骤未到达"]:::business
  summary["确定性汇总同一范围<br/>当前审批人、状态分布、分币种金额"]:::agent
  card["来源、时间线及办理小结<br/>终态无当前待办；不提供审批按钮"]:::ui
  external["真实工单系统接入待完成<br/>替换业务提供者后须重新验收"]:::error
  query --> access
  access --> provider
  provider --> fixture
  provider --> linked
  fixture --> steps
  linked --> steps
  steps --> summary
  summary --> card
  provider -->|"后续接入"| external
  classDef ui fill:#eaf2ff,stroke:#386bc1,color:#1e354c
  classDef agent fill:#edf5ff,stroke:#3778a8,color:#1e354c
  classDef model fill:#f3edff,stroke:#8751bf,color:#1e354c
  classDef business fill:#e8f7ef,stroke:#268255,color:#1e354c
  classDef guard fill:#fff4dc,stroke:#b58022,color:#1e354c
  classDef error fill:#fff0ef,stroke:#ba534e,color:#1e354c
  classDef store fill:#edf1f5,stroke:#60768b,color:#1e354c