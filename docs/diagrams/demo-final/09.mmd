flowchart TD
  input["自然语言或分页请求<br/>报表数据 / 派单记录 / 工单"]:::ui
  lease{"会话租约与当前权限<br/>请求归属、配额、历史权限版本"}:::guard
  model["ModelAssistantPlanner · MODEL<br/>授权字段、查询引用、持续业务焦点"]:::model
  dispatch["派单语义子流程<br/>尝试普通查询后先重查派单候选"]:::agent
  query{"AssistantCodec / BusinessQuery<br/>严格类型、条件、排序、页码及预算"}:::guard
  clarify["帮助 / 澄清 / 拒绝<br/>不丢弃不支持条件、不执行写入"]:::error
  mcp["HTTP MCP business_query<br/>服务端身份、租户、公司、报表权限"]:::business
  facts["完整受限读取与确定性统计<br/>全部报表状态 / 派单归属 / 工单接口"]:::business
  card["持久查询卡片与独立上下文<br/>完整总数、分币种金额、时点和来源"]:::store
  ui["列表、详情、总结与翻页<br/>刷新可恢复；权限变化阻止旧事实展示"]:::ui
  input --> lease
  lease --> model
  model -->|"只读"| query
  model -->|"派单"| dispatch
  model -->|"不确定"| clarify
  query --> mcp
  mcp --> facts
  facts --> card
  card --> ui
  facts -->|"失败或超限"| clarify
  classDef ui fill:#eaf2ff,stroke:#386bc1,color:#1e354c
  classDef agent fill:#edf5ff,stroke:#3778a8,color:#1e354c
  classDef model fill:#f3edff,stroke:#8751bf,color:#1e354c
  classDef business fill:#e8f7ef,stroke:#268255,color:#1e354c
  classDef guard fill:#fff4dc,stroke:#b58022,color:#1e354c
  classDef error fill:#fff0ef,stroke:#ba534e,color:#1e354c
  classDef store fill:#edf1f5,stroke:#60768b,color:#1e354c