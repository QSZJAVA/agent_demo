flowchart TD
  desired["desired 与 effective 分开<br/>通过预检的范围 / 最近成功范围"]:::agent
  reuse{"范围相同且预览有效？<br/>纯记录操作复用原预览"}:::guard
  query["按权限与规则查询<br/>范围扫描或绑定精确目标读取<br/>异常整次失败，保留旧预览/清单"]:::business
  snapshot["冻结预览<br/>客户实体 + FieldFact 字段快照<br/>精确目标和原查询引用随快照冻结"]:::store
  selection{"选择绑定预览ID与记录键<br/>预览权限校验 + 手动选择CAS保存<br/>只保留须排他限定；不动须UNCHANGED"}:::guard
  pending["未完成请求独立标记<br/>不污染已确定公司与报表"]:::error
  resume["明确新操作可继续<br/>含糊的直接建单仍被阻止"]:::agent
  reload["刷新 / 重启 / 会话恢复<br/>重读权威状态，不重新猜选择"]:::ui
  desired --> reuse
  reuse -->|"需新查询"| query
  query --> snapshot
  reuse -->|"可复用"| selection
  snapshot --> selection
  selection -->|"成功"| reload
  selection -->|"失败"| pending
  pending --> resume
  resume -->|"明确纠正"| selection
  classDef ui fill:#eaf2ff,stroke:#386bc1,color:#1e354c
  classDef agent fill:#edf5ff,stroke:#3778a8,color:#1e354c
  classDef model fill:#f3edff,stroke:#8751bf,color:#1e354c
  classDef business fill:#e8f7ef,stroke:#268255,color:#1e354c
  classDef guard fill:#fff4dc,stroke:#b58022,color:#1e354c
  classDef error fill:#fff0ef,stroke:#ba534e,color:#1e354c
  classDef store fill:#edf1f5,stroke:#60768b,color:#1e354c