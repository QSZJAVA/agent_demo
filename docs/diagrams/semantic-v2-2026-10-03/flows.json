  {
    "name": "02 模型语义解析与校验",
    "note": "模型只负责 action / scopeChanges / restrictions；服务端校验原文证据。应用层最多追加一次解析修复。",
    "nodes": [
      {
        "id": "message",
        "col": 1,
        "row": 0,
        "kind": "agent",
        "title": "本轮原始 message",
        "lines": [
          "原文进入受信任服务边界"
        ]
      },
      {
        "id": "context",
        "col": 0,
        "row": 1,
        "kind": "store",
        "title": "权威上下文",
        "lines": [
          "desired / effective / phase",
          "未解状态、排除数、上次 action"
        ]
      },
      {
        "id": "terms",
        "col": 2,
        "row": 1,
        "kind": "agent",
        "title": "权限过滤后的报表候选",
        "lines": [
          "ReportRef + mentionedReportTerms",
          "词典命中只提供实体线索"
        ]
      },
      {
        "id": "protect",
        "col": 1,
        "row": 1,
        "kind": "guard",
        "title": "SensitiveData.modelText",
        "lines": [
          "手机号 / 证件号 / 邮箱",
          "替换为本轮随机 REF 占位符"
        ]
      },
      {
        "id": "payload",
        "col": 1,
        "row": 2,
        "kind": "agent",
        "title": "构造 JSON 输入",
        "lines": [
          "currentMessage + context",
          "不带完整助手历史或业务明细"
        ]
      },
      {
        "id": "options",
        "col": 1,
        "row": 4,
        "kind": "model",
        "title": "构造真实模型调用",
        "lines": [
          "temperature 0；maxTokens 2400",
          "禁用内部工具执行和回调"
        ]
      },
      {
        "id": "schema",
        "col": 1,
        "row": 5,
        "kind": "model",
        "title": "规则提示 + V2 JSON Schema",
        "lines": [
          "native-schema 默认关闭；按端点验证",
          "模型名由实际模型配置提供"
        ]
      },
      {
        "id": "call",
        "col": 1,
        "row": 6,
        "kind": "model",
        "title": "同步 call().content()",
        "lines": [
          "只取完整 JSON 内容",
          "模型不能实际派单或编写 SQL"
        ]
      },
      {
        "id": "decode",
        "col": 1,
        "row": 7,
        "kind": "guard",
        "title": "IntentCodec 严格解码",
        "lines": [
          "version=2；必填/类型/枚举",
          "未知字段和尾随内容拒绝"
        ]
      },
      {
        "id": "ground",
        "col": 1,
        "row": 8,
        "kind": "guard",
        "title": "验证原文证据和协议不变量",
        "lines": [
          "evidence 归一化后属于原文",
          "mentions 属于 evidence"
        ]
      },
      {
        "id": "invariants",
        "col": 1,
        "row": 9,
        "kind": "guard",
        "title": "检查动作、顺序和限制",
        "lines": [
          "公司仅一次 REPLACE/CLEAR",
          "记录修改在后；动作禁止不冲突"
        ]
      },
      {
        "id": "coverage",
        "col": 1,
        "row": 10,
        "kind": "guard",
        "title": "报表实体覆盖检查",
        "lines": [
          "查询类输出必须覆盖",
          "本轮所有已命中的报表候选"
        ]
      },
      {
        "id": "valid",
        "col": 1,
        "row": 11,
        "kind": "guard",
        "title": "所有检查通过？",
        "lines": [
          "JSON / 原文 / 报表覆盖"
        ]
      },
      {
        "id": "repair",
        "col": 2,
        "row": 11,
        "kind": "model",
        "title": "第一次失败：独立重解析",
        "lines": [
          "同一本轮输入 + 修复指令",
          "不采用模型猜测或关键词兜底"
        ]
      },
      {
        "id": "failed",
        "col": 2,
        "row": 13,
        "kind": "error",
        "title": "第二次失败 / 调用异常",
        "lines": [
          "返回友好原因与未解状态",
          "传输异常不走格式修复循环"
        ]
      },
      {
        "id": "restore",
        "col": 1,
        "row": 12,
        "kind": "agent",
        "title": "恢复 REF 到本地原实体",
        "lines": [
          "恢复 mentions / evidence",
          "在原 message 上再次校验"
        ]
      },
      {
        "id": "intent",
        "col": 1,
        "row": 13,
        "kind": "agent",
        "title": "交付 SemanticIntent",
        "lines": [
          "Source=MODEL",
          "交给 Planner，不调用业务工具"
        ]
      }
    ],
