[
  {
    "name": "01 输入到业务的总流程",
    "note": "当前 active V2 主路径；自然语言生成清单与用户确认执行是两次独立交互。",
    "nodes": [
      {
        "id": "input",
        "col": 1,
        "row": 0,
        "kind": "ui",
        "title": "用户输入自然语言",
        "lines": [
          "Vue AgentChat.send"
        ]
      },
      {
        "id": "buttons",
        "col": 0,
        "row": 1,
        "kind": "ui",
        "title": "表格和卡片按钮",
        "lines": [
          "结构化 REST；不经过模型"
        ]
      },
      {
        "id": "request",
        "col": 1,
        "row": 1,
        "kind": "ui",
        "title": "POST /api/agent/chat",
        "lines": [
          "message + conversationId",
          "previewId + excludedRecords"
        ]
      },
      {
        "id": "auth",
        "col": 1,
        "row": 2,
        "kind": "guard",
        "title": "CORS → 会话认证",
        "lines": [
          "Bearer token → 数据库身份",
          "覆盖客户端 X-User-Id"
        ]
      },
      {
        "id": "badAuth",
        "col": 2,
        "row": 2,
        "kind": "error",
        "title": "身份失效：拒绝请求",
        "lines": [
          "HTTP 401；不解析语义"
        ]
      },
      {
        "id": "inputCheck",
        "col": 1,
        "row": 3,
        "kind": "guard",
        "title": "检查非空与长度",
        "lines": [
          "trim；最多 2000 字符"
        ]
      },
      {
        "id": "badInput",
        "col": 2,
        "row": 3,
        "kind": "error",
        "title": "输入不合法",
        "lines": [
          "REST JSON 业务错误码 400",
          "尚未进入语义解析"
        ]
      },
      {
        "id": "route",
        "col": 1,
        "row": 4,
        "kind": "guard",
        "title": "进入 active V2 语义入口",
        "lines": [
          "真实模型调用链"
        ]
      },
      {
        "id": "entry",
        "col": 1,
        "row": 5,
        "kind": "agent",
        "title": "SemanticConversationService",
        "lines": [
          "新建或验证会话归属",
          "检查历史数据可读性"
        ]
      },
      {
        "id": "lease",
        "col": 1,
        "row": 6,
        "kind": "store",
        "title": "配额 + 对话租约",
        "lines": [
          "同会话串行；读取状态",
          "本轮 requestId/previewVersion"
        ]
      },
      {
        "id": "leaseFail",
        "col": 0,
        "row": 6,
        "kind": "error",
        "title": "配额或会话租约失败",
        "lines": [
          "限流/依赖异常/同会话忙",
          "外层 SSE error + done"
        ]
      },
      {
        "id": "semantic",
        "col": 1,
        "row": 7,
        "kind": "model",
        "title": "解析本轮结构化语义",
        "lines": [
          "保护实体；模型输出 V2 JSON",
          "详见第 02 页"
        ]
      },
      {
        "id": "planner",
        "col": 1,
        "row": 8,
        "kind": "agent",
        "title": "校验并合并范围",
        "lines": [
          "公司 / 报表 / 排除项",
          "详见第 03、04 页"
        ]
      },
      {
        "id": "reject",
        "col": 2,
        "row": 8,
        "kind": "error",
        "title": "澄清 / 拒绝 / 失败",
        "lines": [
          "记录 unresolved 和原因",
          "不回落旧范围执行业务"
        ]
      },
      {
        "id": "action",
        "col": 1,
        "row": 9,
        "kind": "guard",
        "title": "是哪一种 action？",
        "lines": [
          "查询 / 建单 / 解释规则"
        ]
      },
      {
        "id": "other",
        "col": 2,
        "row": 10,
        "kind": "agent",
        "title": "HELP / CANCEL_PLAN / SHOW_RESULT",
        "lines": [
          "服务端帮助、取消或读结果",
          "均不执行实际派单"
        ]
      },
      {
        "id": "query",
        "col": 1,
        "row": 10,
        "kind": "business",
        "title": "确定性查询流程",
        "lines": [
          "权限 + 当前目录/规则版本",
          "MCP report_records → 业务库"
        ]
      },
      {
        "id": "preview",
        "col": 1,
        "row": 11,
        "kind": "store",
        "title": "复用或生成预览",
        "lines": [
          "本地规则求值；预览持久化",
          "排除项与预览绑定"
        ]
      },
      {
        "id": "prepare",
        "col": 1,
        "row": 12,
        "kind": "guard",
        "title": "PREPARE_DISPATCH？",
        "lines": [
          "有效范围和排除项已确认"
        ]
      },
      {
        "id": "plan",
        "col": 1,
        "row": 13,
        "kind": "store",
        "title": "创建 PENDING 清单",
        "lines": [
          "语义幂等键 semantic:requestId",
          "没有调用 dispatch_submit"
        ]
      },
      {
        "id": "sse",
        "col": 1,
        "row": 14,
        "kind": "ui",
        "title": "SSE / REST 返回前端",
        "lines": [
          "自然语言：事实文本和卡片事件",
          "按钮：结构化 JSON 结果"
        ]
      },
      {
        "id": "wait",
        "col": 1,
        "row": 15,
        "kind": "ui",
        "title": "用户核对并点击确认",
        "lines": [
          "POST /api/dispatch/jobs"
        ]
      },
      {
        "id": "execute",
        "col": 1,
        "row": 16,
        "kind": "business",
        "title": "持久任务认领与复核",
        "lines": [
          "DispatchJobService → DispatchService",
          "逐条 MCP 提交；详见第 06、08 页"
        ]
      },
      {
        "id": "result",
        "col": 1,
        "row": 17,
        "kind": "store",
        "title": "结果保存与展示",
        "lines": [
          "SUCCESS / FAILED / SKIPPED",
          "UNKNOWN → REVIEW_REQUIRED"
        ]
      }
