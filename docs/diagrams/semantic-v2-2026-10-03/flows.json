  {
    "name": "03 多轮范围与动作规划",
    "note": "desired 是请求范围，effective 是最近成功范围；拒绝的新输入不会被悄悄替换为旧的成功查询。",
    "nodes": [
      {
        "id": "read",
        "col": 1,
        "row": 0,
        "kind": "store",
        "title": "读取 DialogueState",
        "lines": [
          "按会话、租户、操作者归属",
          "hydrate 新的显式 UI 预览"
        ]
      },
      {
        "id": "coverage",
        "col": 1,
        "row": 1,
        "kind": "guard",
        "title": "requireCoverage / requireAction",
        "lines": [
          "CLARIFY 或禁止冲突立即阻断",
          "对应字段置 unresolved"
        ]
      },
      {
        "id": "draft",
        "col": 1,
        "row": 2,
        "kind": "agent",
        "title": "在临时 draft 上合并",
        "lines": [
          "按 scopeChanges 原始顺序",
          "全部公司/报表操作成功才提交"
        ]
      },
      {
        "id": "company",
        "col": 0,
        "row": 3,
        "kind": "agent",
        "title": "COMPANY",
        "lines": [
          "REPLACE：NFKC/去公司后缀/大写",
          "CLEAR：全部可见公司"
        ]
      },
      {
        "id": "reports",
        "col": 2,
        "row": 3,
        "kind": "agent",
        "title": "REPORTS",
        "lines": [
          "REPLACE / ADD / REMOVE / CLEAR",
          "原话逐项映射到 reportId"
        ]
      },
      {
        "id": "records",
        "col": 0,
        "row": 5,
        "kind": "agent",
        "title": "RECORDS 暂不应用",
        "lines": [
          "留到最终范围的预览完成",
          "详见第 05 页"
        ]
      },
      {
        "id": "reportGate",
        "col": 2,
        "row": 4,
        "kind": "guard",
        "title": "报表链接必须可靠",
        "lines": [
          "EXACT/唯一 ALIAS 可继续",
          "FUZZY/AMBIGUOUS/NONE 需澄清"
        ]
      },
      {
        "id": "merge",
        "col": 1,
        "row": 5,
        "kind": "store",
        "title": "提交 desired 范围",
        "lines": [
          "未提及字段保持不变",
          "清除已解决字段的未解标记"
        ]
      },
      {
        "id": "noPartial",
        "col": 2,
        "row": 6,
        "kind": "error",
        "title": "任一合并失败",
        "lines": [
          "不提交部分 draft",
          "相关 unresolved 标记保留"
        ]
      },
      {
        "id": "validate",
        "col": 1,
        "row": 6,
        "kind": "guard",
        "title": "执行前 validate desired",
        "lines": [
          "公司范围、报表可用与权限",
          "移除后为空 / 未解字段拒绝"
        ]
      },
      {
        "id": "action",
        "col": 1,
        "row": 7,
        "kind": "guard",
        "title": "按 action 分支",
        "lines": [
          "语义层没有 EXECUTE 动作"
        ]
      },
      {
        "id": "preview",
        "col": 0,
        "row": 8,
        "kind": "business",
        "title": "PREVIEW / EXPLAIN_RULES",
        "lines": [
          "刷新或复用预览",
          "规则说明来自实际预览"
        ]
      },
      {
        "id": "prepare",
        "col": 1,
        "row": 8,
        "kind": "business",
        "title": "PREPARE_DISPATCH",
        "lines": [
          "复用或刷新相同范围预览",
          "恢复选择后生成 PENDING"
        ]
      },
      {
        "id": "aux",
        "col": 2,
        "row": 8,
        "kind": "agent",
        "title": "HELP / CANCEL / SHOW_RESULT",
        "lines": [
          "服务端文本或当前清单",
          "不靠模型生成业务结论"
        ]
      },
      {
        "id": "effective",
        "col": 1,
        "row": 9,
        "kind": "store",
        "title": "仅查询成功后更新 effective",
        "lines": [
          "previewId 对应成功数据范围",
          "建单成功更新 planId/PLAN_READY"
        ]
      },
      {
