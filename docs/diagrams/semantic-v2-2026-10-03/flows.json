          "报表权限 + 治理灰度可见"
        ]
      },
      {
        "id": "normalize",
        "col": 1,
        "row": 1,
        "kind": "agent",
        "title": "TextNormalizer.normalize",
        "lines": [
          "NFKC + 小写 + 去空白"
        ]
      },
      {
        "id": "scan",
        "col": 1,
        "row": 2,
        "kind": "agent",
        "title": "TermIndex 最长不重叠扫描",
        "lines": [
          "名称 / 编码 / ID / 别名",
          "英文词还检查词边界"
        ]
      },
      {
        "id": "hit",
        "col": 1,
        "row": 3,
        "kind": "guard",
        "title": "命中词典说法？",
        "lines": [
          "按优先类型关联报表"
        ]
      },
      {
        "id": "identity",
        "col": 0,
        "row": 4,
        "kind": "agent",
        "title": "名称 > 编码 > ID > 别名",
        "lines": [
          "唯一 → EXACT 或 ALIAS",
          "一词多报表 → AMBIGUOUS"
        ]
      },
      {
        "id": "fuzzy",
        "col": 2,
        "row": 4,
        "kind": "agent",
        "title": "无命中：模糊候选评分",
        "lines": [
          "编辑距离 / 二元组 Dice",
          "包含相似度取最大值"
        ]
      },
      {
        "id": "threshold",
        "col": 2,
        "row": 5,
        "kind": "guard",
        "title": "候选评分阈值与领先差",
        "lines": [
          "默认阈值 0.6；歧义差 0.15",
          "治理策略可提供当前参数"
        ]
      },
      {
        "id": "result",
        "col": 1,
        "row": 6,
        "kind": "agent",
        "title": "ResolveResult",
        "lines": [
          "EXACT / ALIAS / FUZZY",
          "AMBIGUOUS / ALL / NONE"
        ]
      },
      {
        "id": "planner",
        "col": 1,
        "row": 7,
        "kind": "guard",
        "title": "V2 Planner 二次收紧",
        "lines": [
          "只接受可靠唯一链接",
          "拒绝 FUZZY、ALL、未识别残片"
        ]
      },
      {
        "id": "accept",
        "col": 0,
        "row": 8,
        "kind": "agent",
        "title": "稳定 reportId",
        "lines": [
          "按目录顺序合并范围",
          "不使用模型直接提供的内部 ID"
        ]
      },
