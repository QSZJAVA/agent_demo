<mxfile host="app.diagrams.net" modified="2026-10-03T00:00:00.000Z" agent="Codex" version="26.0.0"><diagram id="semantic-1" name="01 输入到业务的总流程"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="input" value="&lt;b&gt;用户输入自然语言&lt;/b&gt;&lt;br&gt;Vue AgentChat.send" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="buttons" value="&lt;b&gt;表格和卡片按钮&lt;/b&gt;&lt;br&gt;结构化 REST；不经过模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="request" value="&lt;b&gt;POST /api/agent/chat&lt;/b&gt;&lt;br&gt;message + conversationId&lt;br&gt;previewId + excludedRecords" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="auth" value="&lt;b&gt;CORS → 会话认证&lt;/b&gt;&lt;br&gt;Bearer token → 数据库身份&lt;br&gt;覆盖客户端 X-User-Id" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="badAuth" value="&lt;b&gt;身份失效：拒绝请求&lt;/b&gt;&lt;br&gt;HTTP 401；不解析语义" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#ba534e;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="inputCheck" value="&lt;b&gt;检查非空与长度&lt;/b&gt;&lt;br&gt;trim；最多 2000 字符" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="badInput" value="&lt;b&gt;输入不合法&lt;/b&gt;&lt;br&gt;REST JSON 业务错误码 400&lt;br&gt;尚未进入语义解析" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#ba534e;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="route" value="&lt;b&gt;进入 active V2 语义入口&lt;/b&gt;&lt;br&gt;真实模型调用链" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="entry" value="&lt;b&gt;SemanticConversationService&lt;/b&gt;&lt;br&gt;新建或验证会话归属&lt;br&gt;检查历史数据可读性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="lease" value="&lt;b&gt;配额 + 对话租约&lt;/b&gt;&lt;br&gt;同会话串行；读取状态&lt;br&gt;本轮 requestId/previewVersion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1125" width="340" height="110" as="geometry"/></mxCell><mxCell id="leaseFail" value="&lt;b&gt;配额或会话租约失败&lt;/b&gt;&lt;br&gt;限流/依赖异常/同会话忙&lt;br&gt;外层 SSE error + done" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#ba534e;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="1125" width="340" height="110" as="geometry"/></mxCell><mxCell id="semantic" value="&lt;b&gt;解析本轮结构化语义&lt;/b&gt;&lt;br&gt;保护实体；模型输出 V2 JSON&lt;br&gt;详见第 02 页" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3edff;strokeColor=#8751bf;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1290" width="340" height="110" as="geometry"/></mxCell><mxCell id="planner" value="&lt;b&gt;校验并合并范围&lt;/b&gt;&lt;br&gt;公司 / 报表 / 排除项&lt;br&gt;详见第 03、04 页" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1455" width="340" height="110" as="geometry"/></mxCell><mxCell id="reject" value="&lt;b&gt;澄清 / 拒绝 / 失败&lt;/b&gt;&lt;br&gt;记录 unresolved 和原因&lt;br&gt;不回落旧范围执行业务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#ba534e;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="1455" width="340" height="110" as="geometry"/></mxCell><mxCell id="action" value="&lt;b&gt;是哪一种 action？&lt;/b&gt;&lt;br&gt;查询 / 建单 / 解释规则" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1620" width="340" height="110" as="geometry"/></mxCell><mxCell id="other" value="&lt;b&gt;HELP / CANCEL_PLAN / SHOW_RESULT&lt;/b&gt;&lt;br&gt;服务端帮助、取消或读结果&lt;br&gt;均不执行实际派单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="1785" width="340" height="110" as="geometry"/></mxCell><mxCell id="query" value="&lt;b&gt;确定性查询流程&lt;/b&gt;&lt;br&gt;权限 + 当前目录/规则版本&lt;br&gt;MCP report_records → 业务库" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1785" width="340" height="110" as="geometry"/></mxCell><mxCell id="preview" value="&lt;b&gt;复用或生成预览&lt;/b&gt;&lt;br&gt;本地规则求值；预览持久化&lt;br&gt;排除项与预览绑定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1950" width="340" height="110" as="geometry"/></mxCell><mxCell id="prepare" value="&lt;b&gt;PREPARE_DISPATCH？&lt;/b&gt;&lt;br&gt;有效范围和排除项已确认" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="2115" width="340" height="110" as="geometry"/></mxCell><mxCell id="plan" value="&lt;b&gt;创建 PENDING 清单&lt;/b&gt;&lt;br&gt;语义幂等键 semantic:requestId&lt;br&gt;没有调用 dispatch_submit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="2280" width="340" height="110" as="geometry"/></mxCell><mxCell id="sse" value="&lt;b&gt;SSE / REST 返回前端&lt;/b&gt;&lt;br&gt;自然语言：事实文本和卡片事件&lt;br&gt;按钮：结构化 JSON 结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="2445" width="340" height="110" as="geometry"/></mxCell><mxCell id="wait" value="&lt;b&gt;用户核对并点击确认&lt;/b&gt;&lt;br&gt;POST /api/dispatch/jobs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="2610" width="340" height="110" as="geometry"/></mxCell><mxCell id="execute" value="&lt;b&gt;持久任务认领与复核&lt;/b&gt;&lt;br&gt;DispatchJobService → DispatchService&lt;br&gt;逐条 MCP 提交；详见第 06、08 页" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="2775" width="340" height="110" as="geometry"/></mxCell><mxCell id="result" value="&lt;b&gt;结果保存与展示&lt;/b&gt;&lt;br&gt;SUCCESS / FAILED / SKIPPED&lt;br&gt;UNKNOWN → REVIEW_REQUIRED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="2940" width="340" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="input" target="request"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="request" target="auth"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="失效" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="auth" target="badAuth"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="有效" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="auth" target="inputCheck"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="不合法" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="inputCheck" target="badInput"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="合法" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="inputCheck" target="route"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="active" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="route" target="entry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="entry" target="lease"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="lease" target="leaseFail"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="取得租约" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="lease" target="semantic"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="semantic" target="planner"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="不可靠" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="semantic" target="reject"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="不确定/无权限" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="planner" target="reject"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="允许继续" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="planner" target="action"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="辅助动作" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="action" target="other"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="查询类动作" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="action" target="query"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="query" target="preview"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="preview" target="prepare"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="prepare" target="plan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="prepare" target="sse"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="plan" target="sse"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="other" target="sse"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="reject" target="sse"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="有清单" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="sse" target="wait"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="wait" target="execute"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="execute" target="result"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="报表选择/预览" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="buttons" target="query"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="从固定预览建单" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="buttons" target="plan"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="semantic-2" name="02 模型语义解析与校验"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="message" value="&lt;b&gt;本轮原始 message&lt;/b&gt;&lt;br&gt;原文进入受信任服务边界" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="context" value="&lt;b&gt;权威上下文&lt;/b&gt;&lt;br&gt;desired / effective / phase&lt;br&gt;未解状态、排除数、上次 action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="terms" value="&lt;b&gt;权限过滤后的报表候选&lt;/b&gt;&lt;br&gt;ReportRef + mentionedReportTerms&lt;br&gt;词典命中只提供实体线索" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="protect" value="&lt;b&gt;SensitiveData.modelText&lt;/b&gt;&lt;br&gt;手机号 / 证件号 / 邮箱&lt;br&gt;替换为本轮随机 REF 占位符" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="payload" value="&lt;b&gt;构造 JSON 输入&lt;/b&gt;&lt;br&gt;currentMessage + context&lt;br&gt;不带完整助手历史或业务明细" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="options" value="&lt;b&gt;构造真实模型调用&lt;/b&gt;&lt;br&gt;temperature 0；maxTokens 2400&lt;br&gt;禁用内部工具执行和回调" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3edff;strokeColor=#8751bf;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="schema" value="&lt;b&gt;规则提示 + V2 JSON Schema&lt;/b&gt;&lt;br&gt;native-schema 默认关闭；按端点验证&lt;br&gt;模型名由实际模型配置提供" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3edff;strokeColor=#8751bf;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="call" value="&lt;b&gt;同步 call().content()&lt;/b&gt;&lt;br&gt;只取完整 JSON 内容&lt;br&gt;模型不能实际派单或编写 SQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3edff;strokeColor=#8751bf;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1125" width="340" height="110" as="geometry"/></mxCell><mxCell id="decode" value="&lt;b&gt;IntentCodec 严格解码&lt;/b&gt;&lt;br&gt;version=2；必填/类型/枚举&lt;br&gt;未知字段和尾随内容拒绝" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1290" width="340" height="110" as="geometry"/></mxCell><mxCell id="ground" value="&lt;b&gt;验证原文证据和协议不变量&lt;/b&gt;&lt;br&gt;evidence 归一化后属于原文&lt;br&gt;mentions 属于 evidence" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1455" width="340" height="110" as="geometry"/></mxCell><mxCell id="invariants" value="&lt;b&gt;检查动作、顺序和限制&lt;/b&gt;&lt;br&gt;公司仅一次 REPLACE/CLEAR&lt;br&gt;记录修改在后；动作禁止不冲突" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1620" width="340" height="110" as="geometry"/></mxCell><mxCell id="coverage" value="&lt;b&gt;报表实体覆盖检查&lt;/b&gt;&lt;br&gt;查询类输出必须覆盖&lt;br&gt;本轮所有已命中的报表候选" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1785" width="340" height="110" as="geometry"/></mxCell><mxCell id="valid" value="&lt;b&gt;所有检查通过？&lt;/b&gt;&lt;br&gt;JSON / 原文 / 报表覆盖" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1950" width="340" height="110" as="geometry"/></mxCell><mxCell id="repair" value="&lt;b&gt;第一次失败：独立重解析&lt;/b&gt;&lt;br&gt;同一本轮输入 + 修复指令&lt;br&gt;不采用模型猜测或关键词兜底" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3edff;strokeColor=#8751bf;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="1950" width="340" height="110" as="geometry"/></mxCell><mxCell id="failed" value="&lt;b&gt;第二次失败 / 调用异常&lt;/b&gt;&lt;br&gt;返回友好原因与未解状态&lt;br&gt;传输异常不走格式修复循环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#ba534e;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="2280" width="340" height="110" as="geometry"/></mxCell><mxCell id="restore" value="&lt;b&gt;恢复 REF 到本地原实体&lt;/b&gt;&lt;br&gt;恢复 mentions / evidence&lt;br&gt;在原 message 上再次校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="2115" width="340" height="110" as="geometry"/></mxCell><mxCell id="intent" value="&lt;b&gt;交付 SemanticIntent&lt;/b&gt;&lt;br&gt;Source=MODEL&lt;br&gt;交给 Planner，不调用业务工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="2280" width="340" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="message" target="protect"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="context" target="payload"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="terms" target="payload"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="protect" target="payload"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="payload" target="options"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="options" target="schema"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="schema" target="call"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="call" target="decode"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="decode" target="ground"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="ground" target="invariants"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="invariants" target="coverage"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="coverage" target="valid"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="通过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="valid" target="restore"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="首次失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="valid" target="repair"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="最多一次" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="repair" target="call"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="再次失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="valid" target="failed"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="传输/模型异常" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="call" target="failed"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="再校验通过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="restore" target="intent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="再校验失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="restore" target="failed"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="semantic-3" name="03 多轮范围与动作规划"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="read" value="&lt;b&gt;读取 DialogueState&lt;/b&gt;&lt;br&gt;按会话、租户、操作者归属&lt;br&gt;hydrate 新的显式 UI 预览" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="coverage" value="&lt;b&gt;requireCoverage / requireAction&lt;/b&gt;&lt;br&gt;CLARIFY 或禁止冲突立即阻断&lt;br&gt;对应字段置 unresolved" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="draft" value="&lt;b&gt;在临时 draft 上合并&lt;/b&gt;&lt;br&gt;按 scopeChanges 原始顺序&lt;br&gt;全部公司/报表操作成功才提交" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="company" value="&lt;b&gt;COMPANY&lt;/b&gt;&lt;br&gt;REPLACE：NFKC/去公司后缀/大写&lt;br&gt;CLEAR：全部可见公司" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="reports" value="&lt;b&gt;REPORTS&lt;/b&gt;&lt;br&gt;REPLACE / ADD / REMOVE / CLEAR&lt;br&gt;原话逐项映射到 reportId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="records" value="&lt;b&gt;RECORDS 暂不应用&lt;/b&gt;&lt;br&gt;留到最终范围的预览完成&lt;br&gt;详见第 05 页" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="reportGate" value="&lt;b&gt;报表链接必须可靠&lt;/b&gt;&lt;br&gt;EXACT/唯一 ALIAS 可继续&lt;br&gt;FUZZY/AMBIGUOUS/NONE 需澄清" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="merge" value="&lt;b&gt;提交 desired 范围&lt;/b&gt;&lt;br&gt;未提及字段保持不变&lt;br&gt;清除已解决字段的未解标记" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="noPartial" value="&lt;b&gt;任一合并失败&lt;/b&gt;&lt;br&gt;不提交部分 draft&lt;br&gt;相关 unresolved 标记保留" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#ba534e;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="1125" width="340" height="110" as="geometry"/></mxCell><mxCell id="validate" value="&lt;b&gt;执行前 validate desired&lt;/b&gt;&lt;br&gt;公司范围、报表可用与权限&lt;br&gt;移除后为空 / 未解字段拒绝" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1125" width="340" height="110" as="geometry"/></mxCell><mxCell id="action" value="&lt;b&gt;按 action 分支&lt;/b&gt;&lt;br&gt;语义层没有 EXECUTE 动作" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1290" width="340" height="110" as="geometry"/></mxCell><mxCell id="preview" value="&lt;b&gt;PREVIEW / EXPLAIN_RULES&lt;/b&gt;&lt;br&gt;刷新或复用预览&lt;br&gt;规则说明来自实际预览" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="1455" width="340" height="110" as="geometry"/></mxCell><mxCell id="prepare" value="&lt;b&gt;PREPARE_DISPATCH&lt;/b&gt;&lt;br&gt;复用或刷新相同范围预览&lt;br&gt;恢复选择后生成 PENDING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1455" width="340" height="110" as="geometry"/></mxCell><mxCell id="aux" value="&lt;b&gt;HELP / CANCEL / SHOW_RESULT&lt;/b&gt;&lt;br&gt;服务端文本或当前清单&lt;br&gt;不靠模型生成业务结论" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="1455" width="340" height="110" as="geometry"/></mxCell><mxCell id="effective" value="&lt;b&gt;仅查询成功后更新 effective&lt;/b&gt;&lt;br&gt;previewId 对应成功数据范围&lt;br&gt;建单成功更新 planId/PLAN_READY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1620" width="340" height="110" as="geometry"/></mxCell><mxCell id="failure" value="&lt;b&gt;失败记录 phase 和 lastReason&lt;/b&gt;&lt;br&gt;422 → CLARIFY；其他业务拒绝&lt;br&gt;基础设施异常 → FAILED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="1785" width="340" height="110" as="geometry"/></mxCell><mxCell id="next" value="&lt;b&gt;下一轮继续&lt;/b&gt;&lt;br&gt;这些/剩下的参考权威状态&lt;br&gt;未解条件不能沿用旧数据建单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1950" width="340" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="read" target="coverage"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="允许" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="coverage" target="draft"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="需澄清" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="coverage" target="failure"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="draft" target="company"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="draft" target="reports"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="company" target="merge"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="reports" target="reportGate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="全部成功" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="reportGate" target="merge"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="不可靠" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="reportGate" target="noPartial"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="跳过记录操作" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="draft" target="records"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="merge" target="validate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="有权且明确" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="validate" target="action"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="拒绝" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="validate" target="failure"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="noPartial" target="failure"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="查询/规则" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="action" target="preview"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="建单" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="action" target="prepare"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="辅助" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="action" target="aux"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="preview" target="effective"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="prepare" target="effective"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="aux" target="next"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="effective" target="next"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="failure" target="next"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="semantic-4" name="04 报表实体解析"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="mention" value="&lt;b&gt;模型提取的报表原话&lt;/b&gt;&lt;br&gt;例如 销售报表 / 应收台账" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="visible" value="&lt;b&gt;先限定当前可派单目录&lt;/b&gt;&lt;br&gt;同租户 + 已发布/生效/可用&lt;br&gt;报表权限 + 治理灰度可见" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="normalize" value="&lt;b&gt;TextNormalizer.normalize&lt;/b&gt;&lt;br&gt;NFKC + 小写 + 去空白" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="scan" value="&lt;b&gt;TermIndex 最长不重叠扫描&lt;/b&gt;&lt;br&gt;名称 / 编码 / ID / 别名&lt;br&gt;英文词还检查词边界" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="hit" value="&lt;b&gt;命中词典说法？&lt;/b&gt;&lt;br&gt;按优先类型关联报表" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="identity" value="&lt;b&gt;名称 &gt; 编码 &gt; ID &gt; 别名&lt;/b&gt;&lt;br&gt;唯一 → EXACT 或 ALIAS&lt;br&gt;一词多报表 → AMBIGUOUS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="fuzzy" value="&lt;b&gt;无命中：模糊候选评分&lt;/b&gt;&lt;br&gt;编辑距离 / 二元组 Dice&lt;br&gt;包含相似度取最大值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="threshold" value="&lt;b&gt;候选评分阈值与领先差&lt;/b&gt;&lt;br&gt;默认阈值 0.6；歧义差 0.15&lt;br&gt;治理策略可提供当前参数" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="result" value="&lt;b&gt;ResolveResult&lt;/b&gt;&lt;br&gt;EXACT / ALIAS / FUZZY&lt;br&gt;AMBIGUOUS / ALL / NONE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1125" width="340" height="110" as="geometry"/></mxCell><mxCell id="planner" value="&lt;b&gt;V2 Planner 二次收紧&lt;/b&gt;&lt;br&gt;只接受可靠唯一链接&lt;br&gt;拒绝 FUZZY、ALL、未识别残片" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1290" width="340" height="110" as="geometry"/></mxCell><mxCell id="accept" value="&lt;b&gt;稳定 reportId&lt;/b&gt;&lt;br&gt;按目录顺序合并范围&lt;br&gt;不使用模型直接提供的内部 ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="1455" width="340" height="110" as="geometry"/></mxCell><mxCell id="clarify" value="&lt;b&gt;提示完整名称或候选报表&lt;/b&gt;&lt;br&gt;用户补充名称或显式 UI 选择&lt;br&gt;不自动选择最高分候选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#ba534e;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="1455" width="340" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="mention" target="normalize"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="visible" target="scan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="normalize" target="scan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="scan" target="hit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="hit" target="identity"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="hit" target="fuzzy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="fuzzy" target="threshold"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="threshold" target="result"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="identity" target="result"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="result" target="planner"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="EXACT/唯一 ALIAS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="planner" target="accept"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="模糊/歧义/未知" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="planner" target="clarify"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="semantic-5" name="05 预览、规则与记录选择"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="scope" value="&lt;b&gt;校验最终 desired&lt;/b&gt;&lt;br&gt;是否和 effective 相同？&lt;br&gt;是否有 ACTIVE、版本有效预览？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="reuse" value="&lt;b&gt;符合条件：复用预览&lt;/b&gt;&lt;br&gt;仅记录修改/建单可复用&lt;br&gt;普通 PREVIEW 通常重新查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="new" value="&lt;b&gt;需要重新查询&lt;/b&gt;&lt;br&gt;PreviewCommand：明确范围&lt;br&gt;先保存 QUERYING 状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="stamp" value="&lt;b&gt;查询前记录版本指纹&lt;/b&gt;&lt;br&gt;目录 / 当前规则 / 权限&lt;br&gt;配额与对话租约持续检查" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="mcp" value="&lt;b&gt;MCP report_records(cursor)&lt;/b&gt;&lt;br&gt;可信 tenantId/operatorId&lt;br&gt;每批 500；按 ID 递增" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="query" value="&lt;b&gt;业务侧权限和粗筛&lt;/b&gt;&lt;br&gt;账号当前权限 + 公司范围&lt;br&gt;租户 / 未派单 / 游标条件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;Agent 侧当前规则求值&lt;/b&gt;&lt;br&gt;具体公司规则优先于通配&lt;br&gt;Aviator Boolean；异常按未命中" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="persist" value="&lt;b&gt;生成持久化预览&lt;/b&gt;&lt;br&gt;超过 5000 → 分批持久化&lt;br&gt;确认最新 requestVersion 后激活" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1125" width="340" height="110" as="geometry"/></mxCell><mxCell id="supersede" value="&lt;b&gt;激活新预览时&lt;/b&gt;&lt;br&gt;旧 ACTIVE → SUPERSEDED&lt;br&gt;旧 PENDING 清单 → EXPIRED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="1125" width="340" height="110" as="geometry"/></mxCell><mxCell id="bind" value="&lt;b&gt;绑定最终预览及 UI 选择&lt;/b&gt;&lt;br&gt;previewId 相同才接纳&lt;br&gt;同范围刷新可迁移并重新验证" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1290" width="340" height="110" as="geometry"/></mxCell><mxCell id="stale" value="&lt;b&gt;旧选择不可恢复 / 范围变了&lt;/b&gt;&lt;br&gt;设置 unresolvedRecords&lt;br&gt;要求重新选择；不默认全部派" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#ba534e;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="1455" width="340" height="110" as="geometry"/></mxCell><mxCell id="rows" value="&lt;b&gt;需要记录修改时读取真实预览&lt;/b&gt;&lt;br&gt;最多 5000 条；每页 100&lt;br&gt;更多记录先缩小范围" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1455" width="340" height="110" as="geometry"/></mxCell><mxCell id="match" value="&lt;b&gt;SelectionResolver 依次匹配&lt;/b&gt;&lt;br&gt;单据号精确 → 去类别前缀&lt;br&gt;仍无命中 → label 包含匹配" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1620" width="340" height="110" as="geometry"/></mxCell><mxCell id="unique" value="&lt;b&gt;是否恰好匹配一条？&lt;/b&gt;&lt;br&gt;重复单据号或描述歧义拒绝" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1785" width="340" height="110" as="geometry"/></mxCell><mxCell id="key" value="&lt;b&gt;转换 RecordKey&lt;/b&gt;&lt;br&gt;reportId + 字符串 recordId&lt;br&gt;ADD 排除；REMOVE 恢复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1950" width="340" height="110" as="geometry"/></mxCell><mxCell id="unclear" value="&lt;b&gt;0 条或多条命中&lt;/b&gt;&lt;br&gt;返回澄清提示&lt;br&gt;请用表格精确勾选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#ba534e;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="1785" width="340" height="110" as="geometry"/></mxCell><mxCell id="selection" value="&lt;b&gt;校验排除项都属于当前预览&lt;/b&gt;&lt;br&gt;CLEAR 恢复全部&lt;br&gt;REPLACE 替换排除集合" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="2115" width="340" height="110" as="geometry"/></mxCell><mxCell id="action" value="&lt;b&gt;PREPARE_DISPATCH？&lt;/b&gt;&lt;br&gt;否则返回预览或规则说明" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="2280" width="340" height="110" as="geometry"/></mxCell><mxCell id="zero" value="&lt;b&gt;0 条候选或仅查询&lt;/b&gt;&lt;br&gt;不创建清单&lt;br&gt;返回事实文本与 selection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="2445" width="340" height="110" as="geometry"/></mxCell><mxCell id="plan" value="&lt;b&gt;PlanService 创建清单&lt;/b&gt;&lt;br&gt;固定预览 + 排除项 + 幂等键&lt;br&gt;条数上限 5000；PENDING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="2445" width="340" height="110" as="geometry"/></mxCell><mxCell id="card" value="&lt;b&gt;持久化卡片并 SSE 返回&lt;/b&gt;&lt;br&gt;有效预览约 30 分钟&lt;br&gt;待确认清单约 10 分钟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="2610" width="340" height="110" as="geometry"/></mxCell><mxCell id="e0" value="可复用" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="scope" target="reuse"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="需刷新" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="scope" target="new"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="new" target="stamp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="stamp" target="mcp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="mcp" target="query"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="query" target="rules"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="还有下一批" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="rules" target="mcp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="扫描完成" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="rules" target="persist"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="persist" target="supersede"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="persist" target="bind"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="reuse" target="bind"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="选择来源无效" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="bind" target="stale"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="修改或验证排除项" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="bind" target="rows"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="无需变更选择" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="bind" target="action"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="自然语言记录变更" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="rows" target="match"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="仅验证已有/UI键" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="rows" target="selection"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="match" target="unique"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="非唯一" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="unique" target="unclear"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="唯一" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="unique" target="key"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="key" target="selection"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="有缺失键" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="selection" target="stale"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="全部有效" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="selection" target="action"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="查询/零候选" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="action" target="zero"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="生成清单" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="action" target="plan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="plan" target="card"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="zero" target="card"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="semantic-6" name="06 确认、执行与结果核对"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="confirm" value="&lt;b&gt;用户点击确认卡片&lt;/b&gt;&lt;br&gt;POST /api/dispatch/jobs；不经过模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="gate" value="&lt;b&gt;归属、权限、TTL、版本复核&lt;/b&gt;&lt;br&gt;已 EXECUTED → 返回原结果&lt;br&gt;不是有效 PENDING 则拒绝" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="invalid" value="&lt;b&gt;清单不可确认&lt;/b&gt;&lt;br&gt;返回当前状态或错误&lt;br&gt;无权限/失效/正在执行等" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#ba534e;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="replay" value="&lt;b&gt;重放已有清单结果&lt;/b&gt;&lt;br&gt;原状态已 EXECUTED&lt;br&gt;直接返回，不再调用网关" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="claim" value="&lt;b&gt;CAS 认领执行权&lt;/b&gt;&lt;br&gt;确认 PENDING / 重试 EXECUTED&lt;br&gt;→ EXECUTING + executionVersion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="check" value="&lt;b&gt;按清单 ID 重读和规则复核&lt;/b&gt;&lt;br&gt;当前记录仍待派单且有权&lt;br&gt;复核失败且未发送可恢复 PENDING" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1125" width="340" height="110" as="geometry"/></mxCell><mxCell id="item" value="&lt;b&gt;逐条是否仍符合？&lt;/b&gt;&lt;br&gt;取消/过期/失权不能继续" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1290" width="340" height="110" as="geometry"/></mxCell><mxCell id="skip" value="&lt;b&gt;SKIPPED&lt;/b&gt;&lt;br&gt;记录已变化；未调用网关" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="1455" width="340" height="110" as="geometry"/></mxCell><mxCell id="intent" value="&lt;b&gt;先持久化发送意图&lt;/b&gt;&lt;br&gt;requestId=planId-itemId&lt;br&gt;条目 UNKNOWN + 审计 INTENT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1455" width="340" height="110" as="geometry"/></mxCell><mxCell id="call" value="&lt;b&gt;MCP dispatch_submit&lt;/b&gt;&lt;br&gt;操作者 / 记录 / 规则模式&lt;br&gt;原认领执行版本冻结传递" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1620" width="340" height="110" as="geometry"/></mxCell><mxCell id="business" value="&lt;b&gt;业务服务重新读取有效身份&lt;/b&gt;&lt;br&gt;公司、报表权限&lt;br&gt;锁用户、幂等请求和清单" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1785" width="340" height="110" as="geometry"/></mxCell><mxCell id="duplicate" value="&lt;b&gt;稳定请求号和负载是否一致？&lt;/b&gt;&lt;br&gt;同号不同负载 → 拒绝&lt;br&gt;已 SUCCESS → 重放成功" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1950" width="340" height="110" as="geometry"/></mxCell><mxCell id="fence" value="&lt;b&gt;验证已确认清单和条目&lt;/b&gt;&lt;br&gt;EXECUTING / confirmedBy&lt;br&gt;executionVersion / UNKNOWN 意图" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="2115" width="340" height="110" as="geometry"/></mxCell><mxCell id="source" value="&lt;b&gt;原子业务事务复核&lt;/b&gt;&lt;br&gt;锁目录、规则和源记录&lt;br&gt;版本、规则、当前待派单状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="2280" width="340" height="110" as="geometry"/></mxCell><mxCell id="commit" value="&lt;b&gt;事务提交业务状态与结果&lt;/b&gt;&lt;br&gt;业务表状态 + 请求结果同事务&lt;br&gt;当前是本地业务库，非外部 ERP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="2445" width="340" height="110" as="geometry"/></mxCell><mxCell id="persist" value="&lt;b&gt;Agent 保存逐条结果及审计&lt;/b&gt;&lt;br&gt;SUCCESS / FAILED / SKIPPED&lt;br&gt;超时/不确定 → UNKNOWN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="2610" width="340" height="110" as="geometry"/></mxCell><mxCell id="uncertain" value="&lt;b&gt;有未知/保存失败/执行中断？&lt;/b&gt;&lt;br&gt;所有条目遍历并聚合" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="2775" width="340" height="110" as="geometry"/></mxCell><mxCell id="finish" value="&lt;b&gt;EXECUTED&lt;/b&gt;&lt;br&gt;保存实际成功和失败数&lt;br&gt;返回结果卡片" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="2940" width="340" height="110" as="geometry"/></mxCell><mxCell id="review" value="&lt;b&gt;REVIEW_REQUIRED&lt;/b&gt;&lt;br&gt;不能认为全部失败&lt;br&gt;不允许盲目自动重发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="2940" width="340" height="110" as="geometry"/></mxCell><mxCell id="lookup" value="&lt;b&gt;用户或管理员显式核对&lt;/b&gt;&lt;br&gt;MCP dispatch_lookup&lt;br&gt;锁定读等待在途结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="3105" width="340" height="110" as="geometry"/></mxCell><mxCell id="known" value="&lt;b&gt;核对结果明确？&lt;/b&gt;&lt;br&gt;SUCCESS / FAILED / NOT_FOUND&lt;br&gt;UNKNOWN 则继续等待" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="3270" width="340" height="110" as="geometry"/></mxCell><mxCell id="resolved" value="&lt;b&gt;更新未知条目&lt;/b&gt;&lt;br&gt;NOT_FOUND → 未发送的明确失败&lt;br&gt;全部明确后解除待核对状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="3435" width="340" height="110" as="geometry"/></mxCell><mxCell id="retry" value="&lt;b&gt;用户显式 retry-failed&lt;/b&gt;&lt;br&gt;仅 FAILED；原操作者必须有效&lt;br&gt;重新复核，沿用原请求号" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="3600" width="340" height="110" as="geometry"/></mxCell><mxCell id="close" value="&lt;b&gt;管理员安全关闭明确失败&lt;/b&gt;&lt;br&gt;权限 + 原清单范围检查&lt;br&gt;未知/在途状态不能强行关闭" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="3600" width="340" height="110" as="geometry"/></mxCell><mxCell id="acceptJob" value="&lt;b&gt;接受稳定幂等任务&lt;/b&gt;&lt;br&gt;按当前权限检查；冻结清单版本&lt;br&gt;重复请求返回同一任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="queueJob" value="&lt;b&gt;dispatch_job QUEUED&lt;/b&gt;&lt;br&gt;最多等待 10 分钟&lt;br&gt;请求快速返回任务标识" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="workerJob" value="&lt;b&gt;后台认领 RUNNING 任务&lt;/b&gt;&lt;br&gt;跨实例 CAS；重新读取操作者&lt;br&gt;以下仍复用原派单与核对服务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="e0" value="不可确认" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="gate" target="invalid"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="已执行" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="gate" target="replay"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="允许确认" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="gate" target="claim"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="claim" target="check"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="check" target="item"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="不符合" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="item" target="skip"><mxGeometry relative="1" as="geometry"/></mxCe