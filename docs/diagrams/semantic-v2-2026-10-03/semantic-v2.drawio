ndFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="fence" target="source"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="source" target="commit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="commit" target="persist"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="skip" target="persist"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="还有下一条" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="persist" target="item"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="全部处理完成" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="persist" target="uncertain"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="调用异常：UNKNOWN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="call" target="persist"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="uncertain" target="finish"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="uncertain" target="review"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="review" target="lookup"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="lookup" target="known"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="UNKNOWN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="known" target="review"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="明确" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="known" target="resolved"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="全部明确" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="resolved" target="finish"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="有明确失败且用户要求" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="finish" target="retry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" value="新任务，原请求号" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="retry" target="acceptJob"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" value="无需重试" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="finish" target="close"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="confirm" target="acceptJob"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="acceptJob" target="queueJob"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="queueJob" target="workerJob"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="workerJob" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="semantic-7" name="07 状态、SSE 与异常恢复"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="conversation" value="&lt;b&gt;agent_conversation&lt;/b&gt;&lt;br&gt;会话归属、标题、请求版本&lt;br&gt;deleted/erasure 拒绝继续写" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="lease" value="&lt;b&gt;semantic_dialogue 租约&lt;/b&gt;&lt;br&gt;默认单轮 180 秒&lt;br&gt;租约 + version CAS；不跨模型持事务" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="model" value="&lt;b&gt;模型调用 / 规则扫描&lt;/b&gt;&lt;br&gt;阶段之间 check 租约与配额&lt;br&gt;被取消或超时不能提交业务变更" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3edff;strokeColor=#8751bf;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="save" value="&lt;b&gt;fenced() 小事务保存&lt;/b&gt;&lt;br&gt;校验 token / version / expiry&lt;br&gt;state_json 脱敏持久化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="turn" value="&lt;b&gt;semantic_turn&lt;/b&gt;&lt;br&gt;脱敏原文、意图、模型&lt;br&gt;结果、原因、耗时、状态版本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="business" value="&lt;b&gt;预览 / 清单 / 条目 / 追溯&lt;/b&gt;&lt;br&gt;业务数据和状态持久化&lt;br&gt;更新正文与卡片记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="text" value="&lt;b&gt;服务端生成事实回复&lt;/b&gt;&lt;br&gt;数量、状态、规则来自服务&lt;br&gt;不再请求模型润色回答" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="events" value="&lt;b&gt;SSE 事件&lt;/b&gt;&lt;br&gt;conversation / text / preview&lt;br&gt;plan / selection / error / done" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1125" width="340" height="110" as="geometry"/></mxCell><mxCell id="seq" value="&lt;b&gt;requestId:seq + 输出脱敏&lt;/b&gt;&lt;br&gt;前端按请求/序号校验&lt;br&gt;卡片、文字与选择分别处理" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1290" width="340" height="110" as="geometry"/></mxCell><mxCell id="front" value="&lt;b&gt;前端更新并落地历史恢复线索&lt;/b&gt;&lt;br&gt;忽略旧账号/旧会话响应&lt;br&gt;selection 绑定指定 previewId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1455" width="340" height="110" as="geometry"/></mxCell><mxCell id="disconnected" value="&lt;b&gt;SSE 断开 / 页面刷新&lt;/b&gt;&lt;br&gt;不保证原文本流续传&lt;br&gt;读取已经保存的业务状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#ba534e;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="1620" width="340" height="110" as="geometry"/></mxCell><mxCell id="restore" value="&lt;b&gt;历史 + card-states + selection&lt;/b&gt;&lt;br&gt;必要时查询持久化 preview job&lt;br&gt;选择恢复失败先阻止建单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1785" width="340" height="110" as="geometry"/></mxCell><mxCell id="phase" value="&lt;b&gt;错误阶段持久化&lt;/b&gt;&lt;br&gt;422 → CLARIFY；业务拒绝&lt;br&gt;REJECTED；其他异常 FAILED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="1620" width="340" height="110" as="geometry"/></mxCell><mxCell id="next" value="&lt;b&gt;新的一轮&lt;/b&gt;&lt;br&gt;重新取权威状态/目录&lt;br&gt;上一轮禁止仅 THIS_TURN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1950" width="340" height="110" as="geometry"/></mxCell><mxCell id="previewJobs" value="&lt;b&gt;独立异步预览接口&lt;/b&gt;&lt;br&gt;UI preview_job 可恢复&lt;br&gt;active 语义查询直接调用 PreviewService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;strokeColor=#3778a8;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="1950" width="340" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="conversation" target="lease"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="lease" target="model"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="model" target="save"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="save" target="turn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="save" target="business"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="turn" target="text"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="business" target="text"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="text" target="events"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="events" target="seq"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="seq" target="front"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="正常完成" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="front" target="next"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="断线/刷新" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="front" target="disconnected"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="disconnected" target="restore"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="restore" target="next"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="异常/不可靠" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="model" target="phase"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="phase" target="events"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="有独立预览任务" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="previewJobs" target="restore"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="semantic-8" name="08 异步派单任务与恢复"><mxGraphModel dx="1340" dy="2000" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="button" value="&lt;b&gt;用户明确提交操作&lt;/b&gt;&lt;br&gt;确认 / 重试 / 核对 / 手工派单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="135" width="340" height="110" as="geometry"/></mxCell><mxCell id="key" value="&lt;b&gt;先保存稳定任务幂等键&lt;/b&gt;&lt;br&gt;POST /api/dispatch/jobs&lt;br&gt;丢失响应时沿用原键" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="340" height="110" as="geometry"/></mxCell><mxCell id="admit" value="&lt;b&gt;归属、权限、参数与队列预算&lt;/b&gt;&lt;br&gt;冻结清单版本；同清单仅一在途任务&lt;br&gt;不经过模型决定是否执行" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="465" width="340" height="110" as="geometry"/></mxCell><mxCell id="queued" value="&lt;b&gt;持久化 QUEUED&lt;/b&gt;&lt;br&gt;返回任务号；排队最多 10 分钟&lt;br&gt;租户最多 100、用户最多 8 在途任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="claim" value="&lt;b&gt;跨实例认领 RUNNING&lt;/b&gt;&lt;br&gt;FOR UPDATE SKIP LOCKED&lt;br&gt;5 分钟租约，30 秒续租" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="expired" value="&lt;b&gt;未启动即排队过期&lt;/b&gt;&lt;br&gt;FAILED；未发送业务请求&lt;br&gt;用户刷新后重新确认" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#ba534e;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="795" width="340" height="110" as="geometry"/></mxCell><mxCell id="service" value="&lt;b&gt;重新读身份并复用业务服务&lt;/b&gt;&lt;br&gt;确认 / retryFailed / reconcile&lt;br&gt;手工派单持久化逐记录清单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="960" width="340" height="110" as="geometry"/></mxCell><mxCell id="mcp" value="&lt;b&gt;真实 HTTP MCP 业务服务&lt;/b&gt;&lt;br&gt;冻结原认领 executionVersion&lt;br&gt;稳定请求号、规则和源记录复核" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f7ef;strokeColor=#268255;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1125" width="340" height="110" as="geometry"/></mxCell><mxCell id="result" value="&lt;b&gt;保存可靠业务结果和任务结果&lt;/b&gt;&lt;br&gt;SUCCEEDED 是任务完成&lt;br&gt;条目成功/失败以实际结果为准" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1290" width="340" height="110" as="geometry"/></mxCell><mxCell id="query" value="&lt;b&gt;GET /api/dispatch/jobs/{id}&lt;/b&gt;&lt;br&gt;前端每秒读取持久任务&lt;br&gt;结果卡片与业务页刷新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#386bc1;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="1455" width="340" height="110" as="geometry"/></mxCell><mxCell id="disconnect" value="&lt;b&gt;页面刷新 / 连接中断&lt;/b&gt;&lt;br&gt;本机保留任务号和原幂等键&lt;br&gt;后台继续，不自动创建新任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#ba534e;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="1455" width="340" height="110" as="geometry"/></mxCell><mxCell id="recover" value="&lt;b&gt;运行租约过期或执行崩溃&lt;/b&gt;&lt;br&gt;任务 FAILED，不重新入队&lt;br&gt;清单按持久状态恢复或核对" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f5;strokeColor=#60768b;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="1125" width="340" height="110" as="geometry"/></mxCell><mxCell id="review" value="&lt;b&gt;读取清单与原请求号结果&lt;/b&gt;&lt;br&gt;未知结果必须先核对&lt;br&gt;明确失败才允许用户再次重试" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#b58022;fontColor=#1e354c;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="1290" width="340" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="button" target="key"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="key" target="admit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="admit" target="queued"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="queued" target="claim"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="超时未启动" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="queued" target="expired"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="claim" target="service"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="service" target="mcp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="mcp" target="result"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="result" target="query"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="断线" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="query" target="disconnect"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="仅恢复读取" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="disconnect" target="query"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="执行中断" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="claim" target="recover"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="recover" target="review"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="查看持久状态" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#657891;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="review" target="query"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>