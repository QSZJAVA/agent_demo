{
  "version": "p0-2026-10-11-temporal-intent-v1",
  "partition": "regression",
  "businessReviewed": false,
  "provenance": "针对本轮真实回放中绝对月份漂移、参数待选择和完整编辑输入的同类边界补充回归；工程编写，非业务方盲测。",
  "dictionaryScopes": [
    {
      "domain": "REPORT",
      "companyCode": "A",
      "reportId": "rpt-sales-order"
    }
  ],
  "scenarios": [
    {
      "id": "absolute-month-boundaries",
      "turns": [
        {
          "message": "独立查询沪东公司2024年2月整月的销售报表记录。",
          "expect": {
            "kind": "query",
            "domain": "REPORT",
            "view": "LIST",
            "companyCode": "A",
            "reportIds": [
              "rpt-sales-order"
            ],
            "where": [
              [
                "date",
                "GTE",
                "2024-02-01"
              ],
              [
                "date",
                "LT",
                "2024-03-01"
              ]
            ]
          }
        },
        {
          "message": "把查询月份改成2025年12月，保持公司和报表不变。",
          "expect": {
            "kind": "query",
            "domain": "REPORT",
            "view": "LIST",
            "companyCode": "A",
            "reportIds": [
              "rpt-sales-order"
            ],
            "where": [
              [
                "date",
                "GTE",
                "2025-12-01"
              ],
              [
                "date",
                "LT",
                "2026-01-01"
              ]
            ]
          }
        }
      ]
    },
