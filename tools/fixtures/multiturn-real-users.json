[
  {
    "id": "sales-manager",
    "persona": "销售负责人，短句交办、临时插入工单问题",
    "turns": [
      {
        "message": "把A公司的销售数据给我看看，已经派过的也要。",
        "expect": {
          "kind": "query",
          "source": "sales"
        }
      },
      {
        "message": "金额大的放前面，一页两条就行。",
        "expect": {
          "kind": "query",
          "source": "sales",
          "sort": "amount",
          "descending": true,
          "size": 2,
          "page": 1
        }
      },
      {
        "message": "接着看后一页。",
        "expect": {
          "kind": "query",
          "source": "sales",
          "sort": "amount",
          "descending": true,
          "size": 2,
          "page": 2
        }
      },
      {
        "message": "插一句，WO-DEMO-002 现在轮到谁处理了？",
        "expect": {
          "kind": "query",
          "source": "work_order",
          "where": [
            [
              "orderId",
              "EQ",
              "WO-DEMO-002"
            ]
          ],
          "view": "DETAIL",
          "assignee": "陈会计（演示）"
        }
      },
      {
        "message": "再帮我翻一下费用报表，一千块以上的。",
        "expect": {
          "kind": "query",
          "source": "expense",
          "where": [
            [
              "amount",
              "GTE",
              "1000"
            ]
          ]
        }
      },
      {
        "message": "销售这边还有什么能派出去？先看候选，别直接执行。",
        "expect": {
          "kind": "preview",
          "source": "sales"
        }
      }
    ]
  },
