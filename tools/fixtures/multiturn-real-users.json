  {
    "id": "finance-calendar",
    "persona": "财务人员按时间与客户对账，明确跨域切换",
    "turns": [
      {
        "message": "销售报表里，2026年一月到二月底的记录列一下。",
        "expect": {
          "kind": "query",
          "source": "sales",
          "where": [
            [
              "date",
              "GTE",
              "2026-01-01"
            ],
            [
              "date",
              "LTE",
              "2026-02-28"
            ]
          ]
        }
      },
      {
        "message": "只要没派出去的。",
        "expect": {
          "kind": "query",
          "source": "sales",
          "where": [
            [
              "date",
              "GTE",
              "2026-01-01"
            ],
            [
              "date",
              "LTE",
              "2026-02-28"
            ],
            [
              "status",
              "EQ",
              "未派单"
            ]
          ],
          "requireFilters": [
            [
              "status",
              "EQ",
              "未派单"
            ]
          ]
        }
      },
      {
        "message": "那按状态汇总一下这个范围。",
        "expect": {
          "kind": "query",
          "source": "sales",
          "where": [
            [
              "date",
              "GTE",
              "2026-01-01"
            ],
            [
              "date",
              "LTE",
              "2026-02-28"
            ],
            [
              "status",
              "EQ",
              "未派单"
            ]
          ],
          "view": "SUMMARY"
        }
      },
      {
        "message": "重新查应收报表，天津某某贸易有限公司的，不用刚才的日期和状态条件。",
        "expect": {
          "kind": "query",
          "source": "receivable",
          "where": [
            [
              "customerName",
              "EQ",
              "天津某某贸易有限公司"
            ]
          ]
        }
      },
      {
        "message": "天津这家的这笔应收多少钱，到期日是哪天？",
        "expect": {
          "kind": "query",
          "source": "receivable",
          "where": [
            [
              "customerName",
              "EQ",
              "天津某某贸易有限公司"
            ]
          ],
          "view": "DETAIL"
        }
      },
      {
        "message": "先换到工单，看 WO-DEMO-005 被办成什么结果了。",
